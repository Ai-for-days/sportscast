---
// "All wagers for this game" — the page Weatherboard Extended links every
// market entry to, per Derek (2026-08-23): pick a market there, land here to
// see every published wager touching either team's venue for that date, then
// go bet one. Query params: home=<venueId>, away=<venueId>, date=YYYY-MM-DD.
import BaseLayout from '../../components/layout/BaseLayout.astro';
import GameWagerGrid from '../../components/public/GameWagerGrid';
import { getVenueById } from '../../lib/venue-data';
import { getWagersByDate } from '../../lib/wager-store';
import GameOdds from '../../components/odds/GameOdds';
import { publicGroups } from '../../lib/public-odds';
import { toPublicWagerView, type PublicWagerView } from '../../lib/public-wager-view';
import { gameWeatherWagers, feedGameForVenues } from '../../lib/game-pairing';
import { getFeedSummaries, getFeedGame } from '../../lib/odds-feed-store';
import { mergeMainIntoFull, type FeedGame } from '../../lib/odds-feed';
import type { Wager } from '../../lib/wager-types';

export const prerender = false;

const homeId = Astro.url.searchParams.get('home') ?? '';
const awayId = Astro.url.searchParams.get('away') ?? '';
const date = Astro.url.searchParams.get('date') ?? '';

const homeVenue = getVenueById(homeId);
const awayVenue = getVenueById(awayId);
const isValidDate = /^\d{4}-\d{2}-\d{2}$/.test(date) && !Number.isNaN(Date.parse(`${date}T00:00:00Z`));

// Matching lives in game-pairing.ts (shared with the odds page's weather tab), so the two pages can't drift.
// DBD 2026-11-18: the game-start O/U markets were missing here; below them, every Bovada market for the game.
let views: PublicWagerView[] = [];
let feedGame: FeedGame | null = null;
if (homeVenue && awayVenue && isValidDate) {
  const feedLeague = homeVenue.league === 'nwsl' ? 'mls' : homeVenue.league;
  const [dayWagers, summaries] = await Promise.all([
    getWagersByDate(date).catch(() => [] as Wager[]),
    getFeedSummaries(feedLeague).catch(() => []),
  ]);
  views = gameWeatherWagers(dayWagers, homeVenue, awayVenue).map(toPublicWagerView);
  const s = feedGameForVenues(feedLeague, summaries, homeVenue, awayVenue, date);
  const found = s ? await getFeedGame(s.id) : null;
  if (found) {
    feedGame = found.live && (found.live.receivedAt ?? 0) > (found.game.receivedAt ?? 0) ? mergeMainIntoFull(found.game, found.live) : found.game;
  }
}
const stripRank = (x: string) => x.replace(/\s*\(#?\d+\)\s*/g, ' ').trim();
const feedAway = stripRank(feedGame?.competitors.find((c) => !c.home)?.name ?? '');
const feedHome = stripRank(feedGame?.competitors.find((c) => c.home)?.name ?? '');

const notFound = !homeVenue || !awayVenue || !isValidDate;
const displayDate = isValidDate
  ? new Date(`${date}T12:00:00`).toLocaleDateString('en-US', { timeZone: 'America/New_York', weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' })
  : '';

const title = notFound
  ? 'Game not found'
  : `${awayVenue!.team ?? awayVenue!.city} @ ${homeVenue!.team ?? homeVenue!.city} — All Wagers`;
const description = notFound
  ? 'This game could not be found on Wager on Weather.'
  : `Every published weather market for ${awayVenue!.city} at ${homeVenue!.city} on ${displayDate}.`;
---

<BaseLayout title={title} description={description} noIndexFollow>
  <main class="min-h-screen bg-slate-50">
    <div class="mx-auto max-w-5xl px-4 py-10">
      {notFound ? (
        <div class="text-center">
          <h1 class="text-3xl font-bold text-slate-900">Game not found</h1>
          <p class="mt-3 text-slate-600">We couldn't find that game. It may have already been played, or the link may be incomplete.</p>
          <a href="/wagers" class="mt-6 inline-block rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700">Browse all markets</a>
        </div>
      ) : (
        <Fragment>
          <h1 class="text-2xl font-bold text-slate-900">{awayVenue!.team ?? awayVenue!.city} @ {homeVenue!.team ?? homeVenue!.city}</h1>
          <p class="mt-1 text-sm text-slate-600">{displayDate} — every published weather market for this game.</p>
          <div class="mt-6">
            <GameWagerGrid wagers={views} client:load />
          </div>
          <section class="mt-10">
            <h2 class="text-xl font-bold text-slate-900">Sportsbook odds for this game</h2>
            {feedGame ? (
              <Fragment>
                <p class="mt-1 text-sm text-slate-600">{publicGroups(feedGame.groups).reduce((n, g) => n + g.markets.length, 0)} markets. <a class="font-semibold text-blue-600 hover:underline" href={`/weatherboard/game/${feedGame.id}`}>Open the full odds page</a></p>
                <div class="mt-4">
                  <GameOdds client:only="react" gameId={feedGame.id} groups={feedGame.groups} awayName={feedAway} homeName={feedHome} startTime={feedGame.startTime} />
                </div>
              </Fragment>
            ) : (
              <p class="mt-2 rounded-xl border border-slate-200 bg-white p-6 text-sm text-slate-500">No sportsbook odds posted for this game right now.</p>
            )}
          </section>
          <a href="/wagers" class="mt-8 inline-block text-sm font-semibold text-blue-600 hover:underline">Browse all markets →</a>
        </Fragment>
      )}
    </div>
  </main>
</BaseLayout>
