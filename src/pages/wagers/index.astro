---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import PublicWagerList from '../../components/public/PublicWagerList';
import { listPublicWagers, type PublicWagerView } from '../../lib/public-wager-view';
import { getBreadcrumbSchema, getCollectionPageSchema } from '../../lib/schema-markup';

export const prerender = false;

// ── Step 114: Public wager discovery & market browsing ──────────────────────
// ── 2026-08-26: expired markets are admin-only ─────────────────────────────
//
// Per Derek: "no one should be able to see expired wagers except the admin."
// This page used to fetch all four statuses (open / locked / graded / void)
// and render one section each, which published every settled and cancelled
// market to the world. It now fetches nothing but current and future markets
// through listPublicWagers, which has no status option left to pass. The
// browsing UI in PublicWagerList owns date / type filtering and sorting.

let wagers: PublicWagerView[] = [];
let total = 0;
const INITIAL_CURSOR = 100;
try {
  // Two pages up front so the table's filters have a real corpus to work
  // over on first paint; PublicWagerList pages the rest in on demand.
  const [p1, p2] = await Promise.all([
    listPublicWagers({ limit: 50, cursor: 0 }),
    listPublicWagers({ limit: 50, cursor: 50 }),
  ]);
  wagers = [...p1.wagers, ...p2.wagers];
  total = p1.total;
} catch {
  /* swallow, render empty state */
}

// Structured data lists only the published markets this page already shows
// (listPublicWagers: current and future markets only), by title and link. No
// odds or prices in the markup.
const pageTitle = 'Weather Markets';
const pageDescription = 'Browse the weather markets open now and coming up on Wager on Weather, by date and market type.';
const jsonLd = [
  getBreadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Weather Markets', url: '/wagers' },
  ]),
  getCollectionPageSchema({
    name: pageTitle,
    description: pageDescription,
    url: '/wagers',
    items: wagers.map((w) => ({ name: w.title, url: `/wagers/${w.id}` })),
    numberOfItems: total,
  }),
];
---
<BaseLayout
  title={pageTitle}
  description={pageDescription}
  jsonLd={jsonLd}
>
  <main class="min-h-screen bg-slate-50">
    <PublicWagerList wagers={wagers} initialCursor={INITIAL_CURSOR} total={total} client:load />
  </main>
</BaseLayout>
