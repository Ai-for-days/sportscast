---
import BaseLayout from '../components/layout/BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import ScheduleGameCard from '../components/schedule/ScheduleGameCard.astro';
import { getScheduleGames } from '../lib/league-schedule';
import { getBreadcrumbSchema } from '../lib/schema-markup';
import { formatDMY } from '../lib/date-format';

// SSR: live schedule + weather + odds + injuries, all time-sensitive.
export const prerender = false;

const WINDOW_DAYS = 14; // weekly (mostly Saturday) cadence — two weeks covers the next couple of slates

const { games, truncated } = await getScheduleGames('ncaa-football', WINDOW_DAYS);
const throughDate = formatDMY(Date.now() + WINDOW_DAYS * 86400000);

const title = 'NCAA Football Schedule — Upcoming Games, Weather & Odds';
const description = `Every upcoming NCAA football game in the next ${WINDOW_DAYS} days — matchup, stadium, game-day weather forecast, DraftKings betting lines, and injury reports.`;
const jsonLd = [
  getBreadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'NCAA Football Schedule', url: '/ncaa-football-schedule' },
  ]),
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="mx-auto max-w-4xl px-4 py-6">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'NCAA Football Schedule' }]} />
    <header class="mt-3">
      <h1 class="text-3xl font-bold text-text dark:text-text-dark">NCAA Football Schedule</h1>
      <p class="mt-1 text-lg text-text-muted dark:text-text-dark-muted">Upcoming games through {throughDate}</p>
      <p class="mt-3 max-w-3xl text-text dark:text-text-dark">
        Every tracked NCAA football game in the next {WINDOW_DAYS} days, no matter where it's played — matchup, stadium, game-day weather forecast, DraftKings/FanDuel betting lines, and reported injuries. Covers our tracked SEC, Big Ten, ACC, Big 12, and other major-conference programs.
      </p>
    </header>

    {games.length === 0 && (
      <div class="mt-8 rounded-xl border border-border bg-surface p-6 text-text-muted dark:border-border-dark dark:bg-surface-dark-alt dark:text-text-dark-muted">
        <p>No NCAA football games are scheduled in the next {WINDOW_DAYS} days. Browse <a href="/venues/ncaa-football" class="font-semibold text-field hover:underline dark:text-field-light">all NCAA football stadium forecasts</a> instead.</p>
      </div>
    )}

    <div class="mt-6 space-y-3">
      {games.map(game => <ScheduleGameCard game={game} />)}
    </div>

    {truncated && (
      <p class="mt-4 text-sm text-text-muted dark:text-text-dark-muted">Showing the first 150 games in this window — more are scheduled beyond what's listed here.</p>
    )}

    <p class="mt-6 text-xs text-text-muted dark:text-text-dark-muted">Schedule via ESPN. Forecasts are produced by WagerOnWeather. Odds via The Odds API — informational only, not betting advice. Injury reports via ESPN.</p>

    <div class="mt-4">
      <a href="/venues/ncaa-football" class="text-sm font-semibold text-field hover:underline dark:text-field-light">Browse all NCAA football stadium forecasts →</a>
    </div>
  </div>
</BaseLayout>
