---
// Bare /weatherboard: TODAY ONLY, every tracked league, mixed together.
// Per-league views (Today/Tomorrow tabs + calendar) live at their own
// dedicated URLs now — /weatherboard/nfl, /weatherboard/college-football,
// /weatherboard/mlb, /weatherboard/mls (see LeagueWeatherboard.astro) —
// rather than this same page branching on a `?sport=` query param, per
// Derek: "there should only be 5 Weatherboard pages."
import BaseLayout from '../components/layout/BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import WeatherboardTable from '../components/schedule/WeatherboardTable.astro';
import { getScheduleGames, type SiteLeague } from '../lib/league-schedule';
import { getBreadcrumbSchema } from '../lib/schema-markup';
import { gameDayDateStr } from '../lib/mlb-schedule';

export const prerender = false;

const ET = 'America/New_York';

const LEAGUE_CONFIG: Record<SiteLeague, { label: string; urlSegment: string }> = {
  mlb: { label: 'MLB', urlSegment: 'mlb' },
  nfl: { label: 'NFL', urlSegment: 'nfl' },
  'ncaa-football': { label: 'NCAA Football', urlSegment: 'college-football' },
  mls: { label: 'MLS & Soccer', urlSegment: 'mls' },
};
const LEAGUE_KEYS: SiteLeague[] = ['mlb', 'nfl', 'ncaa-football', 'mls'];

// Old query-param URLs (?sport=nfl etc.) 301 to the new dedicated pages —
// preserves any bookmarked/indexed links from before this split.
const requestedSport = Astro.url.searchParams.get('sport');
if (requestedSport && LEAGUE_KEYS.includes(requestedSport as SiteLeague)) {
  const seg = LEAGUE_CONFIG[requestedSport as SiteLeague].urlSegment;
  const day = Astro.url.searchParams.get('day');
  return Astro.redirect(`/weatherboard/${seg}${day === 'tomorrow' ? '?day=tomorrow' : ''}`, 301);
}

function localDateStr(iso: string): string {
  const d = new Date(iso);
  return Number.isNaN(d.getTime()) ? '' : d.toLocaleDateString('en-CA', { timeZone: ET });
}
// "Today" runs 6am ET to 6am ET the next morning, not midnight to midnight
// — so last night's finals stay on the Today view until 6am, per Derek.
const todayStr = gameDayDateStr(new Date());

const panelGroups = await Promise.all(
  LEAGUE_KEYS.map(async (k) => {
    const result = await getScheduleGames(k, 1);
    return {
      league: k,
      label: LEAGUE_CONFIG[k].label,
      games: result.games.filter((g) => localDateStr(g.kickoffUTC) === todayStr),
    };
  }),
);
const hasAnyGames = panelGroups.some((g) => g.games.length > 0);

const title = "The Weatherboard — Today's Game-Day Weather & Odds";
const description = 'Every tracked MLB, NFL, NCAA Football, and MLS game TODAY — venue, a game-day weather write-up, Weather Experience Score, and DraftKings moneyline/run line/total with official rotation numbers.';
const jsonLd = [
  getBreadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'The Weatherboard', url: '/weatherboard' },
  ]),
];

// Edge-cache for 1 minute (short — this page shows live in-progress
// scores/innings), served stale for up to 5 more while Vercel revalidates
// in the background.
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="mx-auto max-w-6xl px-4 py-6">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'The Weatherboard' }]} />
    <header class="mt-3">
      <h1 class="text-3xl font-bold text-text dark:text-text-dark">The Weatherboard</h1>
      <p class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-text dark:text-text-dark">
        <span class="font-semibold">Dedicated Weatherboards:</span>
        {LEAGUE_KEYS.map((k, i) => (
          <Fragment>
            <a href={`/weatherboard/${LEAGUE_CONFIG[k].urlSegment}`} class="font-semibold text-field hover:underline dark:text-field-light">{LEAGUE_CONFIG[k].label}</a>
            {i < LEAGUE_KEYS.length - 1 && <span class="text-text-muted dark:text-text-dark-muted">·</span>}
          </Fragment>
        ))}
      </p>
    </header>

    <div class="mt-5">
      {!hasAnyGames && (
        <p class="rounded-xl border border-border bg-surface p-6 text-sm text-text-muted dark:border-border-dark dark:bg-surface-dark-alt dark:text-text-dark-muted">No tracked games today.</p>
      )}
      {panelGroups.map(g => g.games.length > 0 && (
        <div class="mb-6">
          <WeatherboardTable games={g.games} leagueLabel={g.label} emptyMessage="" />
        </div>
      ))}
    </div>

    <p class="mt-6 text-xs text-text-muted dark:text-text-dark-muted">
      Forecasts are produced by Wager on Weather. Odds via The Odds API (DraftKings) — informational only, not betting advice; rotation numbers are best-effort and may be blank for newly-listed games. Odds move; confirm at your sportsbook before wagering. 21+ and physically present in an eligible state. Gambling problem? Call 1-800-GAMBLER.
    </p>
  </div>
</BaseLayout>
