---
import BaseLayout from '../components/layout/BaseLayout.astro';
import AccountDashboard from '../components/account/AccountDashboard';
import { BettingSidebarWithProvider } from '../components/betting/BettingSidebarWithProvider';
import { getUserSessionFromCookies, validateUserSession } from '../lib/user-auth';

export const prerender = false;

// Check if user is logged in
const cookieHeader = Astro.request.headers.get('cookie');
const cookieValue = getUserSessionFromCookies(cookieHeader);
const userSession = cookieValue ? await validateUserSession(cookieValue) : null;
const isLoggedIn = !!userSession;
---

<BaseLayout title="My Account — Wager on Weather" noIndex>
  <div class="min-h-screen bg-white" style="color-scheme: light;">
    <div class="mx-auto max-w-4xl px-4 py-6">
      <AccountDashboard client:only="react" />
    </div>
  </div>

  {/* Betting Sidebar - Only for logged-in users */}
  {isLoggedIn && (
    <BettingSidebarWithProvider client:only="react" />
  )}
</BaseLayout>
