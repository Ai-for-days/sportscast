---
// Players the owner adds get a temporary password and land here after their
// first sign-in to choose their own (DBD 2026-11-20). Betting is blocked on the
// server until they do (mustChangePassword, /api/bets and /api/bets/place).
import BaseLayout from '../components/layout/BaseLayout.astro';
import { requireUser } from '../lib/user-auth';

export const prerender = false;

const user = await requireUser(Astro.request);
if (!user) return Astro.redirect('/login');
Astro.response.headers.set('Cache-Control', 'private, no-store');

const title = 'Set Your Password';
const description = 'Choose your own password to start betting.';
const forced = !!user.mustChangePassword;
---

<BaseLayout {title} {description} noIndex={true}>
  <div class="mx-auto max-w-md px-4 py-12">
    <div class="rounded-lg border border-border bg-surface p-8 dark:border-border-dark dark:bg-surface-dark-alt">
      <h1 class="mb-2 text-2xl font-bold text-text dark:text-text-dark">Set your password</h1>
      <p class="mb-6 text-sm text-text-muted dark:text-text-dark-muted">
        {forced
          ? 'You signed in with a temporary password. Choose your own to start betting.'
          : 'Change your password.'}
      </p>
      <form id="pwForm" class="space-y-4">
        <div>
          <label for="current" class="block text-sm font-semibold text-text dark:text-text-dark">{forced ? 'Temporary password' : 'Current password'}</label>
          <input type="password" id="current" required autocomplete="current-password"
            class="mt-1 w-full rounded border border-border bg-white px-3 py-2 text-sm dark:border-border-dark dark:bg-surface-dark" />
        </div>
        <div>
          <label for="next" class="block text-sm font-semibold text-text dark:text-text-dark">New password (at least 8 characters)</label>
          <input type="password" id="next" required minlength="8" autocomplete="new-password"
            class="mt-1 w-full rounded border border-border bg-white px-3 py-2 text-sm dark:border-border-dark dark:bg-surface-dark" />
        </div>
        <div>
          <label for="again" class="block text-sm font-semibold text-text dark:text-text-dark">New password again</label>
          <input type="password" id="again" required minlength="8" autocomplete="new-password"
            class="mt-1 w-full rounded border border-border bg-white px-3 py-2 text-sm dark:border-border-dark dark:bg-surface-dark" />
        </div>
        <p id="pwMsg" class="text-sm text-red-600" role="alert"></p>
        <button type="submit" class="w-full rounded bg-field px-4 py-2 font-semibold text-white hover:bg-field-dark">Save password</button>
      </form>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('pwForm') as HTMLFormElement;
  const msg = document.getElementById('pwMsg') as HTMLElement;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const currentPassword = (document.getElementById('current') as HTMLInputElement).value;
    const newPassword = (document.getElementById('next') as HTMLInputElement).value;
    const again = (document.getElementById('again') as HTMLInputElement).value;
    msg.textContent = '';
    if (newPassword.length < 8) { msg.textContent = 'Use at least 8 characters.'; return; }
    if (newPassword !== again) { msg.textContent = 'The two new passwords do not match.'; return; }
    if (newPassword === currentPassword) { msg.textContent = 'Choose a password different from the temporary one.'; return; }
    try {
      const res = await fetch('/api/auth/change-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ currentPassword, newPassword }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) { msg.textContent = data.error || 'Could not save the password.'; return; }
      window.location.href = '/bettheforecast';
    } catch {
      msg.textContent = 'Network error. Please try again.';
    }
  });
</script>
