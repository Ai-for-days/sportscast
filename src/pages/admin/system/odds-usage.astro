---
// Admin-only: metered credit usage on The Odds API (the-odds-api.com),
// which backs DraftKings moneyline/run-line/total lines across the
// Weatherboard and venue pages. Read-only. No secrets rendered — never the
// API key itself.
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import SystemNav from '../../../components/admin/SystemNav';
import { requireAdmin } from '../../../lib/admin-auth';
import { getOddsApiUsage, oddsApiConfigured, getOddsFetchConfig, getOddsUsageLog, SPORT_KEY_LABELS, type OddsUsageLogEntry } from '../../../lib/sportsbook-odds';

export const prerender = false;

const session = await requireAdmin(Astro.request);
if (!session) {
  return Astro.redirect('/admin');
}

const configured = oddsApiConfigured();
const usage = configured ? await getOddsApiUsage() : null;
const fetchConfig = await getOddsFetchConfig();
const usageLog: OddsUsageLogEntry[] = configured ? await getOddsUsageLog() : [];

// Grouped by sport + endpoint kind (odds lines vs. live scores) — "exactly
// what was spent and on what," per Derek. Built from the rolling spend log
// (last 200 real requests), not an all-time total — the-odds-api.com's own
// dashboard is the source of truth for a full billing-period total.
interface SpendSummaryRow {
  sportKey: string;
  kind: 'odds' | 'scores';
  label: string;
  count: number;
  totalCost: number;
  lastAt: string;
}
const spendSummaryMap = new Map<string, SpendSummaryRow>();
for (const entry of usageLog) {
  const key = `${entry.sportKey}:${entry.kind}`;
  const cost = entry.cost ?? 0;
  const existing = spendSummaryMap.get(key);
  if (existing) {
    existing.count += 1;
    existing.totalCost += cost;
    if (entry.capturedAt > existing.lastAt) existing.lastAt = entry.capturedAt;
  } else {
    spendSummaryMap.set(key, {
      sportKey: entry.sportKey,
      kind: entry.kind,
      label: SPORT_KEY_LABELS[entry.sportKey] ?? entry.sportKey,
      count: 1,
      totalCost: cost,
      lastAt: entry.capturedAt,
    });
  }
}
const spendSummary = [...spendSummaryMap.values()].sort((a, b) => b.totalCost - a.totalCost);
const totalLoggedSpend = spendSummary.reduce((sum, r) => sum + r.totalCost, 0);
const RECENT_LOG_ROWS = 30;

const total = usage && usage.requestsUsed !== null && usage.requestsRemaining !== null
  ? usage.requestsUsed + usage.requestsRemaining
  : null;
const pctUsed = total && total > 0 && usage?.requestsUsed !== null
  ? Math.min(100, Math.round(((usage!.requestsUsed as number) / total) * 1000) / 10)
  : null;

const ET = 'America/New_York';
function formatET(iso: string): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return '—';
  return d.toLocaleString('en-US', { timeZone: ET, month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' }) + ' ET';
}

const SPORTS_TRACKED = 5; // mlb, nfl, nfl-preseason, ncaa-football, mls
const COST_PER_FETCH = 3; // h2h + spreads + totals, DraftKings-only = 1 region-equivalent
const CACHE_TTL_HOURS = fetchConfig.intervalHours;
const worstCaseDailyCredits = SPORTS_TRACKED * Math.ceil(24 / CACHE_TTL_HOURS) * COST_PER_FETCH;
const LEAGUES = [
  { key: 'mlb', label: 'MLB' },
  { key: 'nfl', label: 'NFL' },
  { key: 'ncaa-football', label: 'NCAA Football' },
  { key: 'mls', label: 'MLS' },
];
---

<BaseLayout title="Odds API Usage — Admin" noTitleSuffix noIndex>
  <div class="min-h-screen bg-slate-50" style="color-scheme: light;">
    <div class="mx-auto max-w-5xl px-4 py-6 space-y-6">
      <header>
        <h1 class="text-2xl font-bold text-slate-900">Odds API Usage</h1>
        <p class="mt-1 text-sm text-slate-600">
          Read-only credit-usage snapshot for The Odds API — the metered feed behind DraftKings
          moneyline / run line / total lines on the Weatherboard and venue pages. No secrets shown.
        </p>
      </header>

      {!configured && (
        <section class="rounded-xl border border-amber-200 bg-amber-50 p-5 text-sm text-amber-800">
          No <code class="bg-amber-100 px-1">ODDS_API_KEY</code> is configured — odds features are silently disabled site-wide.
        </section>
      )}

      {configured && !usage && (
        <section class="rounded-xl border border-slate-200 bg-white p-5 text-sm text-slate-600">
          No usage captured yet — the count populates the first time any page triggers a real (non-cached) odds
          request. Given the 6-hour cache lifetime, that could take a few hours after a key rotation or deploy.
        </section>
      )}

      {usage && (
        <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 class="mb-3 text-lg font-semibold text-slate-900">Latest known usage</h2>
          <p class="mb-4 text-xs text-slate-500">
            Captured from response headers on the last real request ({usage.sportKey}, {formatET(usage.capturedAt)}).
            A cache hit never touches the network, so this reflects "as of the last real request," not a live meter —
            for a precise current total, check the account dashboard at the-odds-api.com.
          </p>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3 text-sm">
            <div class="rounded-lg bg-slate-50 p-3">
              <div class="text-xs uppercase tracking-wider text-slate-500">Requests used</div>
              <div class="mt-1 text-2xl font-bold text-slate-900">{usage.requestsUsed?.toLocaleString() ?? '—'}</div>
            </div>
            <div class="rounded-lg bg-slate-50 p-3">
              <div class="text-xs uppercase tracking-wider text-slate-500">Requests remaining</div>
              <div class="mt-1 text-2xl font-bold text-slate-900">{usage.requestsRemaining?.toLocaleString() ?? '—'}</div>
            </div>
            <div class="rounded-lg bg-slate-50 p-3">
              <div class="text-xs uppercase tracking-wider text-slate-500">Last request cost</div>
              <div class="mt-1 text-2xl font-bold text-slate-900">{usage.lastRequestCost ?? '—'} credits</div>
            </div>
          </div>

          {pctUsed !== null && (
            <div class="mt-4">
              <div class="flex items-baseline justify-between text-xs text-slate-500">
                <span>{pctUsed}% of current period used</span>
                <span>{total?.toLocaleString()} total credits this period</span>
              </div>
              <div class="mt-1 h-2 overflow-hidden rounded-full bg-slate-200">
                <div
                  class:list={['h-full', pctUsed >= 90 ? 'bg-red-500' : pctUsed >= 70 ? 'bg-amber-500' : 'bg-emerald-500']}
                  style={`width: ${pctUsed}%`}
                />
              </div>
            </div>
          )}
        </section>
      )}

      {configured && usageLog.length > 0 && (
        <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 class="mb-1 text-lg font-semibold text-slate-900">Spend log — what was spent, and on what</h2>
          <p class="mb-4 text-xs text-slate-500">
            Every real (non-cached) request that actually spent credits, grouped by sport and endpoint —
            over the last {usageLog.length} logged request{usageLog.length === 1 ? '' : 's'} (a rolling window,
            not all-time; the-odds-api.com's own dashboard is the source of truth for a full billing-period
            total). The free schedule endpoint (<code class="bg-slate-100 px-1">/events</code>) never costs
            credits and isn't logged here.
          </p>

          <div class="overflow-x-auto">
            <table class="w-full min-w-[520px] text-sm">
              <thead>
                <tr class="border-b border-slate-200 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                  <th class="py-2 pr-4">Sport</th>
                  <th class="py-2 pr-4">Endpoint</th>
                  <th class="py-2 pr-4">Requests</th>
                  <th class="py-2 pr-4">Credits spent</th>
                  <th class="py-2">Last request</th>
                </tr>
              </thead>
              <tbody>
                {spendSummary.map((row) => (
                  <tr class="border-b border-slate-100">
                    <td class="py-2 pr-4 font-medium text-slate-900">{row.label}</td>
                    <td class="py-2 pr-4 text-slate-600">{row.kind === 'odds' ? 'Odds (lines)' : 'Scores'}</td>
                    <td class="py-2 pr-4 text-slate-600">{row.count}</td>
                    <td class="py-2 pr-4 font-semibold text-slate-900">{row.totalCost} credits</td>
                    <td class="py-2 text-slate-500">{formatET(row.lastAt)}</td>
                  </tr>
                ))}
              </tbody>
              <tfoot>
                <tr class="border-t-2 border-slate-300 font-semibold text-slate-900">
                  <td class="py-2 pr-4" colspan="3">Total (this log)</td>
                  <td class="py-2 pr-4">{totalLoggedSpend} credits</td>
                  <td class="py-2"></td>
                </tr>
              </tfoot>
            </table>
          </div>

          <details class="mt-4">
            <summary class="cursor-pointer text-xs font-semibold uppercase tracking-wider text-slate-500">
              Show the {Math.min(RECENT_LOG_ROWS, usageLog.length)} most recent requests
            </summary>
            <div class="mt-2 overflow-x-auto">
              <table class="w-full min-w-[560px] text-sm">
                <thead>
                  <tr class="border-b border-slate-200 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                    <th class="py-2 pr-4">When</th>
                    <th class="py-2 pr-4">Sport</th>
                    <th class="py-2 pr-4">Endpoint</th>
                    <th class="py-2 pr-4">Cost</th>
                    <th class="py-2">Remaining after</th>
                  </tr>
                </thead>
                <tbody>
                  {usageLog.slice(0, RECENT_LOG_ROWS).map((entry) => (
                    <tr class="border-b border-slate-100">
                      <td class="py-2 pr-4 text-slate-600">{formatET(entry.capturedAt)}</td>
                      <td class="py-2 pr-4 text-slate-900">{SPORT_KEY_LABELS[entry.sportKey] ?? entry.sportKey}</td>
                      <td class="py-2 pr-4 text-slate-600">{entry.kind === 'odds' ? 'Odds (lines)' : 'Scores'}</td>
                      <td class="py-2 pr-4 font-medium text-slate-900">{entry.cost ?? '—'} credits</td>
                      <td class="py-2 text-slate-500">{entry.requestsRemaining?.toLocaleString() ?? '—'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </details>
        </section>
      )}

      {configured && (
        <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 class="mb-1 text-lg font-semibold text-slate-900">Fetch control</h2>
          <p class="mb-4 text-xs text-slate-500">
            Full control over when a real request happens: leave it automatic (the site refreshes on its own
            every N hours), switch to manual (the site never requests on its own — only you do, via the
            buttons below), or tune the auto interval.
          </p>

          <form id="odds-config-form" class="flex flex-wrap items-end gap-4">
            <div>
              <div class="text-xs font-semibold uppercase tracking-wider text-slate-500">Mode</div>
              <div class="mt-1 flex overflow-hidden rounded-lg border border-slate-300">
                <label class="cursor-pointer px-3 py-1.5 text-sm has-[:checked]:bg-blue-600 has-[:checked]:text-white">
                  <input type="radio" name="mode" value="auto" checked={fetchConfig.mode === 'auto'} class="sr-only" />Auto
                </label>
                <label class="cursor-pointer px-3 py-1.5 text-sm has-[:checked]:bg-blue-600 has-[:checked]:text-white">
                  <input type="radio" name="mode" value="manual" checked={fetchConfig.mode === 'manual'} class="sr-only" />Manual
                </label>
              </div>
            </div>
            <div>
              <label class="text-xs font-semibold uppercase tracking-wider text-slate-500" for="interval-hours">Auto interval (hours)</label>
              <input
                type="number"
                id="interval-hours"
                name="intervalHours"
                min="1"
                max="168"
                value={fetchConfig.intervalHours}
                class="mt-1 block w-24 rounded-lg border border-slate-300 px-2 py-1.5 text-sm"
              />
            </div>
            <button type="submit" class="rounded-lg bg-slate-900 px-4 py-1.5 text-sm font-semibold text-white hover:bg-slate-700">Save</button>
            <span id="odds-config-status" class="text-sm text-slate-500"></span>
          </form>

          <div class="mt-4 border-t border-slate-200 pt-4">
            <div class="text-xs font-semibold uppercase tracking-wider text-slate-500">Fetch now</div>
            <p class="mt-1 text-xs text-slate-500">Forces a real request immediately, bypassing the cache (and manual mode's no-auto-fetch rule) for the picked league — or all four.</p>
            <div class="mt-2 flex flex-wrap gap-2" id="odds-fetch-now-buttons">
              <button type="button" data-league="" class="odds-fetch-btn rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">All</button>
              {LEAGUES.map((l) => (
                <button type="button" data-league={l.key} class="odds-fetch-btn rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">{l.label}</button>
              ))}
            </div>
            <span id="odds-fetch-status" class="mt-2 block text-sm text-slate-500"></span>
          </div>
        </section>
      )}

      <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="mb-3 text-lg font-semibold text-slate-900">How the site spends credits</h2>

        <div class="space-y-4 text-sm text-slate-700">
          <p>
            Every time this term appears on the site, "request" means one HTTP call from our server to
            The Odds API (the-odds-api.com) — the same thing you might hear called a "fetch" or "API call."
            Only a real request costs credits or shows up in the numbers above; the cache described below
            exists specifically to keep the number of real requests low.
          </p>

          <div>
            <h3 class="font-semibold text-slate-900">What "cached {CACHE_TTL_HOURS} hours" means</h3>
            {fetchConfig.mode === 'manual' ? (
              <p class="mt-1 rounded-lg bg-amber-50 p-3 text-amber-800">
                Currently in <strong>manual mode</strong> — the mechanics below don't apply right now. The site
                will not request fresh odds on its own no matter how old the saved copy gets; only the "Fetch now"
                buttons above touch the network. Switch back to Auto to re-enable the automatic {CACHE_TTL_HOURS}-hour
                refresh described here.
              </p>
            ) : (
              <p class="mt-1">
                When any page needs odds for a sport (say, MLB), the site first checks whether it already has
                a copy of that sport's odds saved from a previous request, and how old that copy is:
              </p>
            )}
            <ul class="mt-2 list-disc space-y-1 pl-5">
              <li><strong>Saved copy is less than {CACHE_TTL_HOURS} hours old</strong> — reuse it. No request is made, no credits are spent, no matter how many visitors hit MLB pages in that window.</li>
              <li><strong>No saved copy, or it's {CACHE_TTL_HOURS}+ hours old</strong> — make one real request for that sport, save the result, and reuse <em>that</em> copy for the next {CACHE_TTL_HOURS} hours.</li>
            </ul>
            <p class="mt-2 text-slate-600">
              Concretely: the first visitor to load an MLB page after the cache expires triggers one request
              that covers MLB's <strong>entire</strong> upcoming slate — not just that one game. Every other
              MLB odds lookup anywhere on the site for the next {CACHE_TTL_HOURS} hours — different visitor,
              different page, different game — reuses that same saved copy for free. Only after {CACHE_TTL_HOURS}
              hours does the next visit trigger a fresh request and reset the clock. (This is the current
              auto-mode interval — change it above, or switch to manual for full control over the network
              trigger yourself.)
            </p>
          </div>

          <div>
            <h3 class="font-semibold text-slate-900">What one request costs</h3>
            <p class="mt-1">
              Each real request costs <strong>{COST_PER_FETCH} credits</strong>. That price comes from asking
              for three markets at once — moneyline (h2h), run line/spread, and total (h2h + spreads + totals)
              — from one bookmaker, DraftKings. The Odds API prices by "region equivalent": any single
              bookmaker, or any group of up to 10, counts as 1 region-equivalent at the same price, so pulling
              just DraftKings costs the same {COST_PER_FETCH} credits as pulling 10 books would.
            </p>
          </div>

          <div>
            <h3 class="font-semibold text-slate-900">What the "Scores" rows are (NFL / NCAA Football / MLS only)</h3>
            <p class="mt-1">
              A separate, paid fallback for when ESPN's own free scoreboard fails us (it has 403'd our
              server before) — The Odds API's <code class="bg-slate-100 px-1">/scores</code> endpoint fills in
              live/final scores for any game ESPN's response is missing, at 2 credits per sport per check.
              Fixed live (2026-08-23): this used to run on <em>every</em> schedule fetch regardless of
              whether ESPN's list was already complete, burning credits for zero benefit on the normal case
              (ESPN healthy, full slate returned). It now only fires when there's an actual gap to fill —
              a real ESPN outage or an ESPN response genuinely missing a tracked game — the exact situation
              this fallback exists for. MLB never uses this (it has its own dedicated MLB Stats API path,
              no ESPN dependency). <strong>Fixed again live (2026-08-24):</strong> the gap check still fired
              constantly for NFL and NCAA Football before their seasons had even started — 400 credits on
              Scores alone in one rolling window, 146 of them NCAA Football, which hadn't played a game yet.
              Cause: the check scanned the site's full lookahead window (weeks out), and the free schedule
              endpoint lists a whole season months in advance, so every not-yet-played future game looked
              like a "gap." A future game has no live/final score to check anyway, so the gate now only
              counts a game as a real gap once it has actually kicked off.
            </p>
          </div>

          <div>
            <h3 class="font-semibold text-slate-900">Worst-case total</h3>
            <p class="mt-1">
              Up to {SPORTS_TRACKED} feeds are tracked (MLB, NFL, NFL Preseason, NCAA Football, MLS) — NFL
              is two separate feeds because the-odds-api.com splits preseason into its own sport key from the
              regular season — each with its own independent {CACHE_TTL_HOURS}-hour cache. The absolute worst
              case — every sport's cache expiring
              and getting refreshed every single time it can, all day, every day — works out to:
            </p>
            <p class="mt-2 rounded-lg bg-slate-50 p-3 font-mono text-xs text-slate-800">
              {SPORTS_TRACKED} sports × {Math.ceil(24 / CACHE_TTL_HOURS)} refreshes/day × {COST_PER_FETCH} credits/refresh
              = <strong>{worstCaseDailyCredits} credits/day</strong> (~{(worstCaseDailyCredits * 30).toLocaleString()}/month)
            </p>
            <p class="mt-2 text-slate-600">
              That's a ceiling, not a typical day — real usage is lower whenever a sport is out of season
              (nothing to fetch, so no request fires) or whenever traffic is light enough that {CACHE_TTL_HOURS}
              hours pass between visits to a given sport's pages.
            </p>
          </div>

          <div>
            <h3 class="font-semibold text-slate-900">Rotation number sanity check</h3>
            <p class="mt-1">
              Real Nevada-style rotation numbers are always 3 digits (100–999). If a response ever contains
              a number outside that range, it's treated as bad data from the upstream feed and dropped
              rather than shown on the site.
            </p>
          </div>
        </div>
      </section>

      <SystemNav client:load activeHref="/admin/system/odds-usage" />
    </div>
  </div>

  <script>
    const configForm = document.getElementById('odds-config-form') as HTMLFormElement | null;
    const configStatus = document.getElementById('odds-config-status');
    const fetchStatus = document.getElementById('odds-fetch-status');

    configForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(configForm);
      const mode = String(data.get('mode') ?? 'auto');
      const intervalHours = Number(data.get('intervalHours') ?? 6);
      if (configStatus) configStatus.textContent = 'Saving…';
      try {
        const res = await fetch('/api/admin/system/odds-fetch', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'set-config', mode, intervalHours }),
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        if (configStatus) configStatus.textContent = 'Saved. Reloading…';
        window.location.reload();
      } catch (err) {
        if (configStatus) configStatus.textContent = `Failed to save: ${err instanceof Error ? err.message : String(err)}`;
      }
    });

    document.querySelectorAll<HTMLButtonElement>('.odds-fetch-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const league = btn.dataset.league || undefined;
        const label = btn.textContent?.trim() || 'league';
        if (fetchStatus) fetchStatus.textContent = `Fetching ${label}…`;
        btn.disabled = true;
        try {
          const res = await fetch('/api/admin/system/odds-fetch', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'fetch-now', league }),
          });
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const data = await res.json();
          const results = (data.results ?? []) as { league: string; success: boolean }[];
          const summary = results.map((r) => `${r.league}: ${r.success ? 'ok' : 'failed'}`).join(', ');
          if (fetchStatus) fetchStatus.textContent = `Done — ${summary}. Reloading…`;
          window.location.reload();
        } catch (err) {
          if (fetchStatus) fetchStatus.textContent = `Failed: ${err instanceof Error ? err.message : String(err)}`;
        } finally {
          btn.disabled = false;
        }
      });
    });
  </script>
</BaseLayout>
