---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import LeagueWeatherboard from '../../components/schedule/LeagueWeatherboard.astro';
import { getBreadcrumbSchema } from '../../lib/schema-markup';
import { WEATHERBOARD_CACHE_CONTROL } from '../../lib/cache-headers';

export const prerender = false;

const requestedDay = Astro.url.searchParams.get('day');
const day: 'today' | 'tomorrow' = requestedDay === 'tomorrow' ? 'tomorrow' : 'today';
const date = Astro.url.searchParams.get('date');

const title = 'MLS — The Weatherboard';
const description = "Today and tomorrow's tracked MLS & Soccer games — venue, a game-day weather write-up, Weather Experience Score, and DraftKings moneyline/run line/total with official rotation numbers.";
const jsonLd = [
  getBreadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'The Weatherboard', url: '/weatherboard' },
    { name: 'MLS & Soccer', url: '/weatherboard/mls' },
  ]),
];

// Same caching rationale as /weatherboard — see that file's comment.
Astro.response.headers.set('Cache-Control', WEATHERBOARD_CACHE_CONTROL);
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="mx-auto max-w-6xl px-4 py-6">
    <LeagueWeatherboard league="mls" label="MLS & Soccer" venuesHref="/venues/mls" urlSegment="mls" day={day} date={date} />

    <p class="mt-6 text-xs text-text-muted dark:text-text-dark-muted">
      Forecasts are produced by Wager on Weather. Odds via The Odds API (DraftKings) — informational only, not betting advice; rotation numbers are best-effort and may be blank for newly-listed games. Odds move; confirm at your sportsbook before wagering. 21+ and physically present in an eligible state. Gambling problem? Call 1-800-GAMBLER.
    </p>
  </div>
</BaseLayout>
