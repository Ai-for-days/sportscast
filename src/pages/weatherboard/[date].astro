---
// One date's games across every tracked league — the "everything else" page
// the main Weatherboard's calendar picker links out to, since that page
// itself only shows Today/Tomorrow/the day after.
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import WeatherboardTable from '../../components/schedule/WeatherboardTable.astro';
import { getScheduleGames, type SiteLeague } from '../../lib/league-schedule';
import { getBreadcrumbSchema } from '../../lib/schema-markup';
import { gameDayDateStr } from '../../lib/mlb-schedule';
import { WEATHERBOARD_CACHE_CONTROL } from '../../lib/cache-headers';
import { getArchivedDay } from '../../lib/game-archive';

export const prerender = false;

const ET = 'America/New_York';
const LEAGUE_CONFIG: Record<SiteLeague, { label: string; urlSegment: string }> = {
  mlb: { label: 'MLB', urlSegment: 'mlb' },
  nfl: { label: 'NFL', urlSegment: 'nfl' },
  'ncaa-football': { label: 'NCAA Football', urlSegment: 'college-football' },
  mls: { label: 'MLS & Soccer', urlSegment: 'mls' },
};
const LEAGUE_KEYS: SiteLeague[] = ['mlb', 'nfl', 'ncaa-football', 'mls'];

const { date: dateParam } = Astro.params;
const isValidDate = !!dateParam && /^\d{4}-\d{2}-\d{2}$/.test(dateParam) && !Number.isNaN(Date.parse(`${dateParam}T00:00:00Z`));
if (!isValidDate) return Astro.redirect('/weatherboard', 302);

function localDateStr(iso: string): string {
  const d = new Date(iso);
  return Number.isNaN(d.getTime()) ? '' : d.toLocaleDateString('en-CA', { timeZone: ET });
}
// "Today" runs 6am ET to 6am ET the next morning — see gameDayDateStr.
const todayStr = gameDayDateStr(new Date());

// How far out is this date? Bound the fetch window generously but not
// unbounded — a date more than 60 days out just returns "no tracked games"
// rather than paying for a huge schedule fetch.
const todayMs = Date.parse(`${todayStr}T00:00:00Z`);
const targetMs = Date.parse(`${dateParam}T00:00:00Z`);
const daysOut = Math.round((targetMs - todayMs) / 86400000);
const windowDays = Math.max(1, Math.min(60, daysOut + 1));
const isPast = daysOut < 0;
const tooFarOut = daysOut > 60;

// A past date is served from the archive, not the feeds. Per Derek
// (2026-09-08): "we want a history of all of the games played." Nothing
// upstream can answer for a finished day — the schedule window starts at the
// current game day and The Odds API drops a game at kickoff — so this reads
// the record /api/cron/archive-games wrote while those games were current.
// Each row keeps the odds it started with (game-closing-odds.ts).
const archived = isPast ? await getArchivedDay(dateParam) : [];
const results = isPast || tooFarOut ? [] : await Promise.all(LEAGUE_KEYS.map((k) => getScheduleGames(k, windowDays)));

const panelGroups = tooFarOut
  ? []
  : LEAGUE_KEYS.map((k, i) => ({
      league: k,
      label: LEAGUE_CONFIG[k].label,
      urlSegment: LEAGUE_CONFIG[k].urlSegment,
      games: isPast
        ? archived.filter((g) => g.league === k)
        : results[i].games.filter((g) => localDateStr(g.kickoffUTC) === dateParam),
    }));
const hasAnyGames = panelGroups.some((g) => g.games.length > 0);
// A past date with no record is not the same claim as a past date with no
// games: the archive only reaches back to when it started being written.
const noArchiveForDate = isPast && !hasAnyGames;

const displayDate = new Date(`${dateParam}T12:00:00`).toLocaleDateString('en-US', { timeZone: ET, weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });

const title = `Games on ${displayDate} — The Weatherboard`;
const description = `Every tracked MLB, NFL, NCAA Football, and MLS game on ${displayDate} — venue, weather, and DraftKings odds.`;
const jsonLd = [
  getBreadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'The Weatherboard', url: '/weatherboard' },
    { name: displayDate, url: `/weatherboard/${dateParam}` },
  ]),
];

// Same caching rationale as /weatherboard — see that file's comment. A
// past/future date's games are mostly static, but this page can also be
// reached for TODAY, which still shows live scores/innings, so it gets the
// same short 60s window rather than a longer one.
Astro.response.headers.set('Cache-Control', WEATHERBOARD_CACHE_CONTROL);
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="mx-auto max-w-6xl px-4 py-6">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'The Weatherboard', href: '/weatherboard' }, { label: displayDate }]} />

    <header class="mt-3 flex flex-wrap items-end justify-between gap-3">
      <div>
        <h1 class="text-3xl font-bold text-text dark:text-text-dark">{displayDate}</h1>
        <p class="mt-1 text-text-muted dark:text-text-dark-muted">Every tracked game on this date, across MLB, NFL, NCAA Football, and MLS.</p>
      </div>
      <div class="flex items-center gap-2">
        <label class="text-sm text-text-muted dark:text-text-dark-muted" for="date-jump">Jump to date</label>
        <input type="date" id="date-jump" value={dateParam} class="rounded-lg border border-border bg-surface px-3 py-1.5 text-sm dark:border-border-dark dark:bg-surface-dark-alt dark:text-text-dark" />
      </div>
    </header>

    <div class="mt-5">
      {tooFarOut && (
        <p class="rounded-xl border border-border bg-surface p-6 text-sm text-text-muted dark:border-border-dark dark:bg-surface-dark-alt dark:text-text-dark-muted">
          That date is too far out to have a tracked schedule yet.
        </p>
      )}
      {noArchiveForDate && (
        <p class="rounded-xl border border-border bg-surface p-6 text-sm text-text-muted dark:border-border-dark dark:bg-surface-dark-alt dark:text-text-dark-muted">
          No games on record for this date. The results archive only goes back as far as we have been keeping it —
          see <a href="/weatherboard/history" class="font-semibold text-field hover:underline dark:text-field-light">the full history</a> for every date we hold.
        </p>
      )}
      {isPast && hasAnyGames && (
        <p class="mb-4 rounded-xl border border-border bg-surface-alt p-4 text-sm text-text-muted dark:border-border-dark dark:bg-surface-dark-alt dark:text-text-dark-muted">
          Final results. The odds shown are the closing line — the last price offered before each game started, not a live quote.
        </p>
      )}
      {!tooFarOut && !isPast && !hasAnyGames && (
        <p class="rounded-xl border border-border bg-surface p-6 text-sm text-text-muted dark:border-border-dark dark:bg-surface-dark-alt dark:text-text-dark-muted">No tracked games on this date.</p>
      )}
      {panelGroups.map(g => g.games.length > 0 && (
        <WeatherboardTable games={g.games} leagueLabel={g.label} emptyMessage="" extendedUrlSegment={g.urlSegment} />
      ))}
    </div>

    <a href="/weatherboard" class="mt-2 inline-block text-sm font-semibold text-field hover:underline dark:text-field-light">← Back to The Weatherboard</a>

    <p class="mt-6 text-xs text-text-muted dark:text-text-dark-muted">
      Forecasts are produced by Wager on Weather. Odds via The Odds API (DraftKings) — informational only, not betting advice; rotation numbers are best-effort and may be blank for newly-listed games. Odds move; confirm at your sportsbook before wagering. 21+ and physically present in an eligible state. Gambling problem? Call 1-800-GAMBLER.
    </p>
  </div>

  <script>
    document.getElementById('date-jump')?.addEventListener('change', (e) => {
      const value = (e.currentTarget as HTMLInputElement).value;
      if (value) window.location.href = `/weatherboard/${value}`;
    });
  </script>
</BaseLayout>
