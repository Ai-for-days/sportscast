---
import Header from './Header.astro';
import Footer from './Footer.astro';
import ReadOnlyBanner from '../admin/ReadOnlyBanner';
// Step 174 — centralized noindex policy. Covers admin + auth + account
// + dashboard + preview/internal route groups. BaseLayout used to only
// check `/admin/*` (Step 173) — now delegates to the helper.
import { isNoIndexPathname } from '../../lib/seo/noindex-policy';
import { ADMIN_NAV, shouldShowAdminNav, renderAdminNavBar } from '../../lib/admin-nav-registry';
import '../../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  jsonLd?: object | object[];
  noTitleSuffix?: boolean;
  noIndex?: boolean;
  /**
   * Step 188 — `noindex, follow`: for pages that are valid and fully
   * functional for visitors but not on the SEO indexable allowlist (e.g.
   * a ZIP page outside `seo-indexable-locations.json`). Distinct from
   * `noIndex` (which renders `noindex, nofollow` for admin/private
   * surfaces): here we still want Google to CRAWL the page and follow its
   * links to hub pages / allowlisted ZIPs, just not index the page itself.
   * If both `noIndex` and `noIndexFollow` are set, `noIndex` wins.
   */
  noIndexFollow?: boolean;
  /**
   * WOW-024: whether an admin session is present. Only /admin itself (the
   * login form / Hub) needs to pass this; every other admin page runs
   * requireAdmin and redirects before it renders, so reaching its layout
   * already implies a session.
   */
  adminSession?: boolean;
}

const {
  title,
  description = 'Weather intelligence for sports and weather markets. Hourly and 15-day forecasts, interactive maps, and sport-specific playability scores for 300+ venues.',
  ogImage,
  jsonLd,
  noTitleSuffix = false,
  noIndex = false,
  noIndexFollow = false,
  adminSession = false,
} = Astro.props;

const isAdminPage = Astro.url.pathname.startsWith('/admin');
const isHomePage = Astro.url.pathname === '/';
// Admin menu bar (WOW-024): replaces the old quick-links bar. Shown only on
// admin paths for a signed-in admin. /admin passes its session state; other
// admin pages are session-implied only when they are a registered admin page
// (a 404 under /admin/ is not, so an anonymous visitor never sees the menu).
const adminPathNorm = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isAdminRoot = adminPathNorm === '/admin';
const isRegisteredAdminPage = ADMIN_NAV.some((x) => x.route === adminPathNorm);
const showQuickLinks = shouldShowAdminNav(
  Astro.url.pathname,
  isAdminRoot ? adminSession === true : isRegisteredAdminPage,
);
const adminNavHtml = showQuickLinks ? renderAdminNavBar(adminPathNorm) : '';
// Step 173 / 174 — defensive private-route noindex. Step 174 widens the
// implicit policy from `/admin/*` to every route group classified by
// `seo/noindex-policy.ts` (auth, account, dashboard, settings, preview,
// internal). Vercel also emits a matching `X-Robots-Tag` header via
// `vercel.json` for `/admin/*` and `/api/admin/*` so the policy applies
// at the HTTP layer too.
const effectiveNoIndex = noIndex || isNoIndexPathname(Astro.url.pathname);
// Step 188 — only takes effect when the stricter noindex/nofollow above
// doesn't already apply.
const effectiveNoIndexFollow = !effectiveNoIndex && noIndexFollow;
// Step 173 — always canonicalize to the non-www host. Even if a future
// request arrives on `www.wageronweather.com` (Vercel 301-redirects it,
// but belt-and-suspenders), the in-page canonical points at the
// non-www origin.
const CANONICAL_HOST = 'https://wageronweather.com';
const canonicalURL = new URL(Astro.url.pathname, CANONICAL_HOST);
const displayTitle = noTitleSuffix ? title : `${title} | Wager on Weather`;
const ogImageUrl = ogImage || `${CANONICAL_HOST}/og-image.png`;

// Normalize JSON-LD to array
const jsonLdItems = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-1T092WNJVR"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-1T092WNJVR');
  </script>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <!-- Both themes are now supported, so let the UA style its own chrome to match. -->
  <meta name="color-scheme" content="light dark" />

  <!--
    Favicons. `/favicon.ico` used to be a PNG with an .ico extension — Vercel
    still advertised it as image/vnd.microsoft.icon, so anything that actually
    parses ICO (the Vercel dashboard, link unfurlers, the Windows shell)
    rejected it while Chrome content-sniffed and rendered it anyway. That is
    why the icon appeared in tabs but nowhere else. It is now a genuine
    multi-size ICO (16/32/48). Keep it that way: re-exporting a PNG over it
    silently reintroduces the same bug.

    The bare `/favicon.ico` path matters independently of these tags — most
    third-party fetchers probe the site root and never read the HTML.
  -->
  <link rel="icon" href="/favicon.ico?v=4" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png?v=4" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=4" />
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png?v=4" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=4" />
  <link rel="manifest" href="/site.webmanifest?v=4" />
  <meta name="theme-color" content="#041E42" />

  <!-- Self-hosted fonts: preload critical weight -->
  <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />

  <!--
    Theme resolution BEFORE first paint. Must be inline and synchronous in
    <head>: if the class were applied from a bundled script the page would paint
    light and then snap to dark, which is worse than having no toggle.
    Order: explicit user choice > OS preference > dark (how the site has always
    looked). Wrapped in try/catch because localStorage throws in some privacy
    modes, and a theme preference is not worth breaking the page over.
  -->
  <script is:inline>
    (function () {
      try {
        var stored = localStorage.getItem('wow-theme');
        var dark = stored === 'dark' || stored === 'greyscale' ? true
          : stored === 'light' ? false
          : !window.matchMedia('(prefers-color-scheme: light)').matches;
        if (dark) document.documentElement.classList.add('dark');
        if (stored === 'greyscale') document.documentElement.classList.add('greyscale');
      } catch (e) {
        document.documentElement.classList.add('dark');
      }
    })();
  </script>

  <!-- Critical CSS to prevent FOUC. Both themes covered so the pre-paint class
       decides the colour rather than this always forcing navy. -->
  <style>
    body { background-color: #ffffff; color: #0f172a; font-family: 'Inter', system-ui, sans-serif; margin: 0; }
    html.dark body { background-color: #041E42; color: #fff; }
  </style>

  <title>{displayTitle}</title>
  <meta name="description" content={description} />
  {effectiveNoIndex && <meta name="robots" content="noindex, nofollow" />}
  {effectiveNoIndexFollow && <meta name="robots" content="noindex, follow" />}
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={displayTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Wager on Weather" />
  <meta property="og:site_name" content="Wager on Weather" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={displayTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <meta name="twitter:image:alt" content="Wager on Weather" />

  <!-- Resource hints -->
  <link rel="dns-prefetch" href="https://api.open-meteo.com" />
  <link rel="dns-prefetch" href="https://nominatim.openstreetmap.org" />

  <!-- JSON-LD structured data -->
  {jsonLdItems.map(schema => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}
</head>
<body class={`flex min-h-screen flex-col overflow-x-hidden${isAdminPage ? ' read-only-disabled is-admin-shell' : ''}`}>
  {isAdminPage && <ReadOnlyBanner client:only="react" />}
  {!isHomePage && <Header />}
  {/* Header is `fixed` (see Header.astro) so it's taken out of flow — this
      spacer reserves the same height so page content doesn't render underneath
      it. The extra mobile-only height accounts for Header.astro's second fixed
      row (the Weatherboard/Venues links, which don't fit next to the logo +
      search below the `md` breakpoint). */}
  {!isHomePage && <div class="h-16 max-md:h-[6.25rem]" aria-hidden="true"></div>}
  {showQuickLinks && (
    <Fragment>
      {/* Admin menu bar (WOW-024). One registry (lib/admin-nav-registry.ts)
          drives this bar, the Hub and admin search; hidden pages are never
          linked. Native <details> dropdowns, server-rendered. */}
      <Fragment set:html={adminNavHtml} />
      {/* Alert Log unread count (2026-10-11): the only call this bar makes. */}
      <script is:inline>
        fetch('/api/admin/alert-log?count=1', { credentials: 'same-origin' })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (d) {
            var b = document.getElementById('alert-log-badge');
            if (b && d && d.unread > 0) { b.textContent = d.unread > 99 ? '99+' : String(d.unread); b.hidden = false; }
          })
          .catch(function () {});
        // Opening one desktop dropdown closes the others.
        document.querySelectorAll('.admin-nav-desktop > details').forEach(function (d) {
          d.addEventListener('toggle', function () {
            if (!d.open) return;
            document.querySelectorAll('.admin-nav-desktop > details[open]').forEach(function (o) { if (o !== d) o.open = false; });
          });
        });
      </script>
      <style is:global>
        .admin-nav { background: linear-gradient(90deg, #1e3a8a, #1d4ed8); border-bottom: 2px solid #60a5fa; color: #fff; position: relative; z-index: 900; }
        .admin-nav-inner { max-width: 1400px; margin: 0 auto; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; padding: 8px 16px; }
        .admin-nav a { text-decoration: none; }
        .admin-nav-home { padding: 6px 10px; border-radius: 5px; background: #fff; color: #1e3a8a; font-size: 12px; font-weight: 800; }
        .admin-nav-home.is-current { outline: 2px solid #fbbf24; }
        .admin-nav-desktop { display: flex; flex-wrap: wrap; gap: 4px; }
        .admin-nav-section { position: relative; }
        .admin-nav-section > summary { list-style: none; cursor: pointer; padding: 6px 10px; border-radius: 5px; font-size: 12px; font-weight: 700; color: #fff; white-space: nowrap; }
        .admin-nav-section > summary::-webkit-details-marker { display: none; }
        .admin-nav-section > summary::after { content: ' \25BE'; font-size: 10px; opacity: 0.8; }
        .admin-nav-section > summary:hover, .admin-nav-section[open] > summary { background: rgba(255,255,255,0.15); }
        .admin-nav-section.is-current > summary { background: #fff; color: #1e3a8a; }
        .admin-nav-desktop .admin-nav-section > ul { position: absolute; left: 0; top: 100%; margin-top: 4px; min-width: 240px; background: #fff; border: 1px solid #cbd5e1; border-radius: 8px; box-shadow: 0 8px 24px rgba(15,23,42,0.18); padding: 6px; list-style: none; z-index: 950; }
        .admin-nav-link { display: block; padding: 6px 10px; border-radius: 5px; color: #1e293b; font-size: 13px; font-weight: 600; }
        .admin-nav-link:hover { background: #eff6ff; color: #1d4ed8; }
        .admin-nav-link[aria-current="page"] { background: #dbeafe; color: #1d4ed8; }
        .admin-nav-search { margin-left: auto; }
        .admin-nav-search input { width: 190px; padding: 6px 10px; border-radius: 5px; border: 0; font-size: 12px; color: #0f172a; background: #fff; }
        .admin-nav-alerts { padding: 6px 10px; border-radius: 5px; background: #b91c1c; color: #fff; font-size: 12px; font-weight: 800; }
        .admin-nav-alerts span { margin-left: 4px; padding: 0 7px; border-radius: 999px; background: #fff; color: #b91c1c; }
        .admin-nav-menu { display: none; width: 100%; }
        .admin-nav-menu > summary { cursor: pointer; padding: 6px 10px; border-radius: 5px; background: rgba(255,255,255,0.15); font-size: 13px; font-weight: 800; }
        .admin-nav-menu .admin-nav-section > ul { list-style: none; margin: 2px 0 6px; padding: 4px; background: #fff; border-radius: 6px; }
        @media (max-width: 767px) {
          .admin-nav-desktop { display: none; }
          .admin-nav-menu { display: block; order: 3; }
          .admin-nav-search { margin-left: 0; flex: 1 1 0; min-width: 0; }
          .admin-nav-search input { width: 100%; box-sizing: border-box; }
          .admin-nav-alerts { white-space: nowrap; }
        }
      </style>
    </Fragment>
  )}
  <main class="flex-1">
    <slot />
  </main>
  <Footer />
</body>
</html>
