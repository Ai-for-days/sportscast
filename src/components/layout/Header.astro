---
import HeaderSearch from '../search/HeaderSearch';
import ThemeToggle from './ThemeToggle.astro';

const NAV_LINKS = [
  { href: '/weatherboard', label: 'WEATHERBOARD ODDS AND LINES' },
  { href: '/venues', label: 'WEATHER AT US VENUES' },
];
---

<!--
  Fixed (not sticky) so it's frozen at the very top of the viewport under
  every scroll condition, not just "while its own scroll container allows
  it" — BaseLayout renders a `h-16` spacer right after this so page content
  doesn't render underneath it (a `fixed` element is out of flow).

  Colors are hardcoded (no `dark:` variants) so the header/footer NEVER
  change with the light/dark/greyscale toggle, per Derek — they're the one
  constant chrome regardless of theme. This intentionally matches the site's
  original all-dark look. Footer.astro mirrors this same fixed palette.
-->
<header class="fixed inset-x-0 top-0 z-50 h-16 border-b border-[#1a3860] bg-[#041E42]/95 backdrop-blur-sm">
  <div class="mx-auto flex h-full max-w-7xl items-center gap-3 px-4">
    <!-- Logo -->
    <a href="/" class="flex shrink-0 items-center gap-2 text-xl font-bold text-[#93c5fd]">
      <picture>
        <source srcset="/logo-header.webp" type="image/webp" />
        <img src="/logo-header.png" alt="Wager on Weather" class="h-10 w-auto" width="80" height="40" />
      </picture>
      <span class="hidden lg:inline">Wager on Weather</span>
    </a>

    <!-- Weatherboard / Venues links -->
    <nav class="hidden shrink-0 items-center gap-4 md:flex" aria-label="Primary">
      {NAV_LINKS.map(link => (
        <a href={link.href} class="text-xs font-semibold tracking-wide text-[#cbd5e1] hover:text-[#93c5fd]">
          {link.label}
        </a>
      ))}
    </nav>

    <!-- City search. On mobile it now lives directly in the header bar
         (the hamburger menu has been removed); on desktop it's centered. -->
    <div class="flex min-w-0 flex-1 md:justify-center">
      <div class="w-full md:max-w-md">
        <HeaderSearch client:only="react" />
      </div>
    </div>

    <ThemeToggle />
  </div>
</header>

<!-- Mobile-only nav row for the two links above (the header row itself is
     too tight on mobile to fit them next to the logo + search). -->
<div class="fixed inset-x-0 top-16 z-40 flex h-9 items-center justify-center gap-4 border-b border-[#1a3860] bg-[#041E42]/95 px-4 backdrop-blur-sm md:hidden">
  {NAV_LINKS.map(link => (
    <a href={link.href} class="text-[11px] font-semibold tracking-wide text-[#cbd5e1] hover:text-[#93c5fd]">
      {link.label}
    </a>
  ))}
</div>
