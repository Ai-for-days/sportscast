---
import { getSessionFromCookies, validateSession } from '../../lib/admin-auth';
import { BettingSidebarWithProvider } from '../betting/BettingSidebarWithProvider';

interface Props {
  title: string;
  description?: string;
  jsonLd?: any[];
}

const { title, description, jsonLd } = Astro.props;

// Check if user is logged in
const cookieHeader = Astro.request.headers.get('cookie');
const sessionId = getSessionFromCookies(cookieHeader);
const isLoggedIn = sessionId ? await validateSession(sessionId) : false;
---

<div class="grid grid-cols-1 gap-6 lg:grid-cols-[1fr_350px]">
  <div class="min-h-screen">
    <div class="px-4 py-6">
      <slot />
    </div>
  </div>

  {/* Betting Sidebar - Show betting UI if logged in, placeholder otherwise */}
  <div class="sticky top-6 hidden h-fit lg:block">
    {isLoggedIn ? (
      <BettingSidebarWithProvider client:only="react" />
    ) : (
      <div class="rounded-lg border border-border bg-surface p-6 dark:border-border-dark dark:bg-surface-dark-alt">
        <p class="text-sm font-semibold text-text dark:text-text-dark">
          Register or Login to Bet
        </p>
        <p class="mt-2 text-xs text-text-muted dark:text-text-dark-muted">
          Create an account to get $100,000 play money and start placing bets.
        </p>
        <a
          href="/auth/login"
          class="mt-4 block text-center rounded bg-field px-4 py-2 text-sm font-semibold text-white hover:bg-field-dark dark:bg-field-light dark:text-field dark:hover:bg-field-light/80"
        >
          Get Started
        </a>
      </div>
    )}
  </div>
</div>
