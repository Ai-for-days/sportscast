---
// Dense, table-based scoreboard (WagerTalk-style) — two rows per game (away
// on top, home on bottom), grouped under a date/league header bar. Replaces
// the old one-card-per-game layout: less chrome, more games per screen.
import { getVenueLogoUrl } from '../../lib/venue-data';
import { formatAmericanOdds } from '../../lib/odds';
import type { EnrichedScheduleGame } from '../../lib/league-schedule';

interface Props {
  games: EnrichedScheduleGame[];
  leagueLabel: string; // e.g. "MLB", "NFL" — used in the group header bar
  emptyMessage: string;
}

const { games, leagueLabel, emptyMessage } = Astro.props;
const ET = 'America/New_York';

function groupDateLabel(iso: string): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return '';
  return d.toLocaleDateString('en-US', { timeZone: ET, weekday: 'long', month: 'long', day: 'numeric' });
}

function timeLabel(iso: string): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return '';
  return d.toLocaleTimeString('en-US', { timeZone: ET, hour: 'numeric', minute: '2-digit' }).replace(' ', '').toLowerCase();
}

function weatherLabel(g: EnrichedScheduleGame): string {
  if (!g.weatherMatters) return 'Indoors';
  if (!g.day) return '—';
  return `${Math.round(g.day.highF)}°/${Math.round(g.day.lowF)}° · ${Math.round(g.day.windSpeedMph)}mph · ${g.day.precipProbability}%`;
}

function moneyline(lines: EnrichedScheduleGame['lines'], side: 'home' | 'away'): string {
  if (!lines) return '—';
  return formatAmericanOdds(side === 'home' ? lines.moneylineHome : lines.moneylineAway);
}

function spread(lines: EnrichedScheduleGame['lines'], side: 'home' | 'away'): string {
  const sp = lines ? (side === 'home' ? lines.spreadHome : lines.spreadAway) : null;
  return sp ? `${sp.point > 0 ? '+' : ''}${sp.point} (${formatAmericanOdds(sp.price)})` : '—';
}

// Group games into date sections, in the order they already arrive (soonest first).
const groups: { label: string; games: EnrichedScheduleGame[] }[] = [];
for (const g of games) {
  const label = groupDateLabel(g.kickoffUTC);
  const last = groups[groups.length - 1];
  if (last && last.label === label) last.games.push(g);
  else groups.push({ label, games: [g] });
}
---

{games.length === 0 && (
  <p class="rounded-xl border border-border bg-surface p-6 text-sm text-text-muted dark:border-border-dark dark:bg-surface-dark-alt dark:text-text-dark-muted">{emptyMessage}</p>
)}

{groups.map(group => (
  <div class="mb-6 overflow-x-auto rounded-lg border border-border dark:border-border-dark">
    <table class="w-full min-w-[820px] border-collapse text-sm">
      <thead>
        <tr class="bg-slate-700 text-left text-xs font-semibold uppercase tracking-wide text-white">
          <th class="px-3 py-2" colspan="9">{leagueLabel} — {group.label}</th>
        </tr>
        <tr class="border-b border-border bg-surface-alt text-left text-xs font-semibold text-text-muted dark:border-border-dark dark:bg-surface-dark-alt dark:text-text-dark-muted">
          <th class="px-3 py-1.5">Time</th>
          <th class="px-2 py-1.5">#</th>
          <th class="px-3 py-1.5">Team</th>
          <th class="px-2 py-1.5">Score</th>
          <th class="px-3 py-1.5">Weather</th>
          <th class="px-3 py-1.5">Total</th>
          <th class="px-3 py-1.5">DraftKings</th>
          <th class="px-3 py-1.5">FanDuel</th>
          <th class="px-3 py-1.5">Injuries</th>
        </tr>
      </thead>
      <tbody>
        {group.games.map(g => {
          const logo = getVenueLogoUrl(g.venue.id);
          const dk = g.lines?.bookmaker === 'DraftKings' ? g.lines : null;
          const fd = g.lines?.bookmaker === 'FanDuel' ? g.lines : null;
          const total = dk?.total ?? fd?.total ?? null;
          const showScore = g.state !== 'pre';
          const rotAway = dk?.awayRotation ?? fd?.awayRotation ?? null;
          const rotHome = dk?.homeRotation ?? fd?.homeRotation ?? null;
          return (
            <Fragment>
              <tr class="border-b border-border/60 bg-surface dark:border-border-dark/60 dark:bg-surface-dark-alt">
                <td class="px-3 py-1.5 align-top font-medium text-text dark:text-text-dark" rowspan="2">
                  {timeLabel(g.kickoffUTC)}
                  {g.state !== 'pre' && <div class="text-[10px] font-normal uppercase text-field dark:text-field-light">{g.statusDetail || g.state}</div>}
                </td>
                <td class="px-2 py-1.5 text-text-muted dark:text-text-dark-muted">{rotAway ?? '—'}</td>
                <td class="px-3 py-1.5 text-text dark:text-text-dark">{g.awayTeam}</td>
                <td class="px-2 py-1.5 font-semibold text-text dark:text-text-dark">{showScore ? g.awayScore ?? '' : ''}</td>
                <td class="px-3 py-1.5 align-top text-xs text-text-muted dark:text-text-dark-muted" rowspan="2">{weatherLabel(g)}</td>
                <td class="px-3 py-1.5 align-top text-xs text-text dark:text-text-dark" rowspan="2">
                  {total ? (
                    <>
                      <div>O {total.point} ({formatAmericanOdds(total.overPrice)})</div>
                      <div>U {total.point} ({formatAmericanOdds(total.underPrice)})</div>
                    </>
                  ) : '—'}
                </td>
                <td class="px-3 py-1.5 text-xs text-text dark:text-text-dark">
                  <div>{moneyline(dk, 'away')}</div>
                  <div class="text-text-muted dark:text-text-dark-muted">{spread(dk, 'away')}</div>
                </td>
                <td class="px-3 py-1.5 text-xs text-text dark:text-text-dark">
                  <div>{moneyline(fd, 'away')}</div>
                  <div class="text-text-muted dark:text-text-dark-muted">{spread(fd, 'away')}</div>
                </td>
                <td class="px-3 py-1.5 align-top text-xs text-text-muted dark:text-text-dark-muted" rowspan="2">
                  {g.awayInjuries.length > 0 && <div>{g.awayTeam.split(' ').pop()}: {g.awayInjuries.length}</div>}
                  {g.homeInjuries.length > 0 && <div>{g.homeTeam.split(' ').pop()}: {g.homeInjuries.length}</div>}
                  {g.awayInjuries.length === 0 && g.homeInjuries.length === 0 && '—'}
                </td>
              </tr>
              <tr class="border-b border-border bg-surface dark:border-border-dark dark:bg-surface-dark-alt">
                <td class="px-2 py-1.5 text-text-muted dark:text-text-dark-muted">{rotHome ?? '—'}</td>
                <td class="px-3 py-1.5 text-text dark:text-text-dark">
                  <a href={`/venues/${g.venue.id}`} class="flex items-center gap-1.5 hover:underline">
                    {logo && <img src={logo} alt="" width="16" height="16" loading="lazy" decoding="async" class="h-4 w-4 shrink-0 object-contain opacity-70" />}
                    {g.homeTeam}
                  </a>
                </td>
                <td class="px-2 py-1.5 font-semibold text-text dark:text-text-dark">{showScore ? g.homeScore ?? '' : ''}</td>
                <td class="px-3 py-1.5 text-xs text-text dark:text-text-dark">
                  <div>{moneyline(dk, 'home')}</div>
                  <div class="text-text-muted dark:text-text-dark-muted">{spread(dk, 'home')}</div>
                </td>
                <td class="px-3 py-1.5 text-xs text-text dark:text-text-dark">
                  <div>{moneyline(fd, 'home')}</div>
                  <div class="text-text-muted dark:text-text-dark-muted">{spread(fd, 'home')}</div>
                </td>
              </tr>
            </Fragment>
          );
        })}
      </tbody>
    </table>
  </div>
))}
