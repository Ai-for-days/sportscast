---
// Dense, table-based scoreboard (WagerTalk-style) — two rows per game (away
// on top, home on bottom), grouped under a date/league header bar.
import { formatAmericanOdds } from '../../lib/odds';
import { ordinal, inningStateLabel } from '../../lib/weather-utils';
import { describeGameWeather, type EnrichedScheduleGame } from '../../lib/league-schedule';
import { getVenueZipUrl } from '../../lib/venue-zip';
import { getWesBand } from '../../lib/wes-scale';
import { getVenueHref } from '../../lib/venue-slug';
import { getWagersByDate } from '../../lib/wager-store';
import type { Wager, WagerLocation, OverUnderWager, PointspreadWager } from '../../lib/wager-types';
import type { Venue } from '../../lib/types';

interface Props {
  games: EnrichedScheduleGame[];
  leagueLabel: string; // e.g. "MLB", "NFL" — used in the group header bar
  emptyMessage: string;
}

const { games, leagueLabel, emptyMessage } = Astro.props;
const ET = 'America/New_York';

function groupDateLabel(iso: string): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return '';
  return d.toLocaleDateString('en-US', { timeZone: ET, weekday: 'long', month: 'long', day: 'numeric' });
}

function timeLabel(iso: string): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return '';
  return d.toLocaleTimeString('en-US', { timeZone: ET, hour: 'numeric', minute: '2-digit' }).replace(' ', '').toLowerCase();
}

function moneyline(lines: EnrichedScheduleGame['lines'], side: 'home' | 'away'): string {
  if (!lines) return '—';
  return formatAmericanOdds(side === 'home' ? lines.moneylineHome : lines.moneylineAway);
}

function runLine(lines: EnrichedScheduleGame['lines'], side: 'home' | 'away'): string {
  const sp = lines ? (side === 'home' ? lines.spreadHome : lines.spreadAway) : null;
  return sp ? `${sp.point > 0 ? '+' : ''}${sp.point} (${formatAmericanOdds(sp.price)})` : '—';
}

function pitcherLabel(p: EnrichedScheduleGame['homePitcher']): string | null {
  if (!p) return null;
  return p.hand ? `${p.name} (${p.hand})` : p.name;
}

/** "Top"/"Middle" belong with the away half-inning, "Bottom"/"End" with home.
 * NFL/NCAA/MLS have no home/away half — `livePeriodClock` (e.g. "Q3 6:49")
 * is shown once, on the home row only, so it doesn't duplicate. */
function inningBadge(g: EnrichedScheduleGame, side: 'home' | 'away'): string | null {
  if (g.state !== 'in') return null;
  if (g.inningState && g.inning) {
    const isAwayHalf = g.inningState === 'Top' || g.inningState === 'Middle';
    if ((side === 'away') !== isAwayHalf) return null;
    return `${inningStateLabel(g.inningState)} ${ordinal(g.inning)}`;
  }
  if (g.livePeriodClock) return side === 'home' ? g.livePeriodClock : null;
  return null;
}

/** Hover tooltip for the WES badge — the breakdown, plus a cap explanation only when a cap is actually active (kept quiet otherwise, per design). */
function wesTitle(w: NonNullable<EnrichedScheduleGame['wes']>): string {
  const base = `WES ${Math.round(w.wesFinal)} — Environmental ${Math.round(w.environmental)}, Fan Feel ${Math.round(w.fanFeel)}, Player Feel ${Math.round(w.playerFeel)} (v${w.wesVersion})`;
  if (w.severeWeatherCap === null) return base;
  return `${base}\nSevere Weather Cap Applied: ${w.severeWeatherCap}\n${w.severeWeatherReason}`;
}

/** Home venue's nearest ZIP page — shown under WES regardless of whether the venue is domed (weather still applies to the surrounding area even when it doesn't affect play inside). */
function venueZipUrl(g: EnrichedScheduleGame): string | null {
  return getVenueZipUrl(g.venue);
}

// ── Native temperature markets (Pointspread / Over-Under at Venue) ─────────
//
// Per Derek (2026-08-23): show the site's own published weather markets
// inline next to the DraftKings odds, when one happens to exist for this
// game's venue(s) and date — never anything unpublished (open/locked only,
// same customer-visibility rule as everywhere else). One Redis fetch per
// distinct date across the whole table, not per game.
function targetDateOf(iso: string): string {
  const d = new Date(iso);
  return Number.isNaN(d.getTime()) ? '' : d.toLocaleDateString('en-CA', { timeZone: ET });
}
const uniqueDates = [...new Set(games.map((g) => targetDateOf(g.kickoffUTC)))].filter(Boolean);
const wagersByDateEntries = await Promise.all(
  uniqueDates.map((d) => getWagersByDate(d).catch(() => [] as Wager[])),
);
const allWagers = wagersByDateEntries.flat().filter((w) => w.status === 'open' || w.status === 'locked');

const LOCATION_TOLERANCE_DEG = 0.05; // ~3-4 miles — city-centroid vs. exact-venue coordinate slop
function locationMatchesVenue(loc: WagerLocation, venue: Venue | null | undefined): boolean {
  if (!venue) return false;
  return Math.abs(loc.lat - venue.lat) < LOCATION_TOLERANCE_DEG && Math.abs(loc.lon - venue.lon) < LOCATION_TOLERANCE_DEG;
}
function isTempMetric(m: string): boolean {
  return m === 'high_temp' || m === 'low_temp';
}
function metricLabel(m: string): string {
  return m === 'high_temp' ? 'High' : m === 'low_temp' ? 'Low' : m;
}

/** Any published pointspread market touching either of this game's two venues. */
function pointspreadsForGame(g: EnrichedScheduleGame): PointspreadWager[] {
  return allWagers.filter((w): w is PointspreadWager =>
    w.kind === 'pointspread' &&
    isTempMetric(w.metricA ?? w.metric) && isTempMetric(w.metricB ?? w.metric) &&
    (locationMatchesVenue(w.locationA, g.venue) || locationMatchesVenue(w.locationA, g.awayVenue) ||
     locationMatchesVenue(w.locationB, g.venue) || locationMatchesVenue(w.locationB, g.awayVenue)),
  );
}

/** Any published over/under market at this specific venue (the away row's own park, or the home row's) — not the whole game, since each side has its own city. */
function overUndersForVenue(venue: Venue | null | undefined): OverUnderWager[] {
  if (!venue) return [];
  return allWagers.filter((w): w is OverUnderWager =>
    w.kind === 'over-under' && isTempMetric(w.metric) && locationMatchesVenue(w.location, venue),
  );
}

/** Per Derek (2026-08-23): a pointspread's two sides belong on the away/home
 * team's own rows, not merged into one spanning cell — a bettor looking at
 * the away row wants that side's own line, not the whole market's summary.
 * Returns which side(s) of `w` belong to `venue` — normally just one, but
 * both if it's a same-venue High-vs-Low pointspread (both sides = that venue). */
function pointspreadSidesForVenue(w: PointspreadWager, venue: Venue | null | undefined): ('A' | 'B')[] {
  if (!venue) return [];
  const sides: ('A' | 'B')[] = [];
  if (locationMatchesVenue(w.locationA, venue)) sides.push('A');
  if (locationMatchesVenue(w.locationB, venue)) sides.push('B');
  return sides;
}

function pointspreadEntriesForVenue(gamePointspreads: PointspreadWager[], venue: Venue | null | undefined): { wager: PointspreadWager; sides: ('A' | 'B')[] }[] {
  const entries: { wager: PointspreadWager; sides: ('A' | 'B')[] }[] = [];
  for (const w of gamePointspreads) {
    const sides = pointspreadSidesForVenue(w, venue);
    if (sides.length > 0) entries.push({ wager: w, sides });
  }
  return entries;
}

function formatPointspreadSide(w: PointspreadWager, side: 'A' | 'B'): string {
  const loc = side === 'A' ? w.locationA : w.locationB;
  const metric = metricLabel(side === 'A' ? (w.metricA ?? w.metric) : (w.metricB ?? w.metric));
  const spreadVal = side === 'A' ? w.spread : -w.spread;
  const spreadStr = spreadVal > 0 ? `+${spreadVal}` : String(spreadVal);
  const odds = side === 'A' ? w.locationAOdds : w.locationBOdds;
  return `${loc.name} ${metric} ${spreadStr} (${formatAmericanOdds(odds)})`;
}

function formatPointspreadEntry(w: PointspreadWager, sides: ('A' | 'B')[]): string {
  return sides.map((side) => formatPointspreadSide(w, side)).join(' / ');
}

function formatOverUnderMarket(w: OverUnderWager): string {
  return `${metricLabel(w.metric)}: O ${w.line} (${formatAmericanOdds(w.over.odds)}) / U ${w.line} (${formatAmericanOdds(w.under.odds)})`;
}

// Group games into date sections, in the order they already arrive (soonest first).
const groups: { label: string; games: EnrichedScheduleGame[] }[] = [];
for (const g of games) {
  const label = groupDateLabel(g.kickoffUTC);
  const last = groups[groups.length - 1];
  if (last && last.label === label) last.games.push(g);
  else groups.push({ label, games: [g] });
}
---

{games.length === 0 && (
  <p class="rounded-xl border border-border bg-surface p-6 text-sm text-text-muted dark:border-border-dark dark:bg-surface-dark-alt dark:text-text-dark-muted">{emptyMessage}</p>
)}

{groups.map(group => (
  <div class="mb-6 overflow-x-auto rounded-lg border border-border dark:border-border-dark">
    <table class="w-full min-w-[900px] border-collapse text-sm">
      <thead>
        <tr class="bg-slate-700 text-left text-xs font-semibold uppercase tracking-wide text-white">
          <th class="px-3 py-2" colspan="10">{leagueLabel} — {group.label}</th>
        </tr>
        <tr class="border-b border-border bg-surface-alt text-left text-xs font-semibold text-text-muted dark:border-border-dark dark:bg-surface-dark-alt dark:text-text-dark-muted">
          <th class="px-3 py-1.5">Time</th>
          <th class="px-2 py-1.5">#</th>
          <th class="px-3 py-1.5">Team</th>
          <th class="px-2 py-1.5">Score</th>
          <th class="px-3 py-1.5">ML</th>
          <th class="px-3 py-1.5">RL</th>
          <th class="px-3 py-1.5">O/U</th>
          <th class="min-w-[180px] px-3 py-1.5">Temperature Pointspread</th>
          <th class="min-w-[160px] px-3 py-1.5">Temperature O/U at Venue</th>
          <th class="min-w-[260px] px-3 py-1.5">Weather</th>
        </tr>
      </thead>
      <tbody>
        {group.games.map(g => {
          const dk = g.lines;
          const showScore = g.state !== 'pre';
          const awayInning = inningBadge(g, 'away');
          const homeInning = inningBadge(g, 'home');
          const awayPitcher = pitcherLabel(g.awayPitcher);
          const homePitcher = pitcherLabel(g.homePitcher);
          const gamePointspreads = pointspreadsForGame(g);
          const awayPointspreadEntries = pointspreadEntriesForVenue(gamePointspreads, g.awayVenue);
          const homePointspreadEntries = pointspreadEntriesForVenue(gamePointspreads, g.venue);
          const awayOverUnders = overUndersForVenue(g.awayVenue);
          const homeOverUnders = overUndersForVenue(g.venue);
          return (
            <Fragment>
              <tr class="border-b border-black bg-surface dark:bg-surface-dark-alt">
                <td class="px-3 py-1.5 align-top font-medium text-text dark:text-text-dark" rowspan="2">
                  {timeLabel(g.kickoffUTC)}
                  <div class="text-[10px] font-normal text-text-muted dark:text-text-dark-muted">ET</div>
                  {g.state !== 'pre' && <div class="text-[10px] font-normal uppercase text-field dark:text-field-light">{g.statusDetail || g.state}</div>}
                </td>
                <td class="px-2 py-1.5 text-text-muted dark:text-text-dark-muted">{dk?.awayRotation ?? '—'}</td>
                <td class="px-3 py-1.5 text-text dark:text-text-dark">
                  {g.awayVenue ? (
                    <a href={getVenueHref(g.awayVenue)} target="_blank" rel="noopener" class="hover:underline">{g.awayTeam}</a>
                  ) : g.awayTeam}
                  {awayPitcher && <div class="text-[11px] font-normal text-text-muted dark:text-text-dark-muted">{awayPitcher}</div>}
                </td>
                <td class="px-2 py-1.5 font-semibold text-text dark:text-text-dark">
                  {showScore ? g.awayScore ?? '' : ''}
                  {awayInning && <div class="text-[10px] font-normal uppercase text-field dark:text-field-light">{awayInning}</div>}
                </td>
                <td class="px-3 py-1.5 text-xs text-text dark:text-text-dark">{moneyline(dk, 'away')}</td>
                <td class="px-3 py-1.5 text-xs text-text dark:text-text-dark">{runLine(dk, 'away')}</td>
                <td class="px-3 py-1.5 text-xs text-text dark:text-text-dark">
                  {dk?.total ? `O ${dk.total.point} (${formatAmericanOdds(dk.total.overPrice)})` : '—'}
                </td>
                <td class="px-3 py-1.5 align-top text-xs leading-snug text-text-muted dark:text-text-dark-muted">
                  {awayPointspreadEntries.length === 0
                    ? '—'
                    : awayPointspreadEntries.map(e => (
                        <div class="mb-1 last:mb-0">
                          <a href={`/wagers/${e.wager.id}`} class="text-field hover:underline dark:text-field-light">{formatPointspreadEntry(e.wager, e.sides)}</a>
                        </div>
                      ))}
                </td>
                <td class="px-3 py-1.5 align-top text-xs leading-snug text-text-muted dark:text-text-dark-muted">
                  {awayOverUnders.length === 0
                    ? '—'
                    : awayOverUnders.map(w => (
                        <div class="mb-1 last:mb-0">
                          <a href={`/wagers/${w.id}`} class="text-field hover:underline dark:text-field-light">{formatOverUnderMarket(w)}</a>
                        </div>
                      ))}
                </td>
                <td class="px-3 py-1.5 align-top text-xs leading-snug text-text-muted dark:text-text-dark-muted" rowspan="2">
                  {describeGameWeather(g)}
                  {g.wes && (() => {
                    const band = getWesBand(g.wes.wesFinal);
                    const bandVars = `--wes-light:${band.light};--wes-dark:${band.dark};`;
                    return (
                      <div class="mt-1.5" style={bandVars}>
                        <div class="flex items-center gap-1">
                          <div
                            class="wes-band-color inline-flex items-baseline gap-1 rounded-full border-2 px-2 py-0.5"
                            title={wesTitle(g.wes)}
                          >
                            <span class="wes-band-color text-[9px] font-semibold uppercase tracking-wide">WES</span>
                            <span class="wes-band-color text-xs font-bold">{Math.round(g.wes.wesFinal)}</span>
                          </div>
                          {g.state === 'in' && (
                            <span class="rounded bg-red-600 px-1 py-0.5 text-[8px] font-bold uppercase tracking-wide text-white">Live</span>
                          )}
                        </div>
                        <div class="wes-band-color mt-0.5 text-[9px] font-semibold">{band.label}</div>
                        <a href="/what-is-wes" class="mt-0.5 block text-[9px] font-semibold text-field hover:underline dark:text-field-light">What's WES?</a>
                      </div>
                    );
                  })()}
                  {venueZipUrl(g) && (
                    <a
                      href={venueZipUrl(g)!}
                      target="_blank"
                      rel="noopener"
                      class="mt-1.5 block text-[9px] font-semibold uppercase leading-tight text-field hover:underline dark:text-field-light"
                    >
                      Current Weather
                    </a>
                  )}
                </td>
              </tr>
              <tr class="border-b-2 border-black bg-surface dark:bg-surface-dark-alt">
                <td class="px-2 py-1.5 text-text-muted dark:text-text-dark-muted">{dk?.homeRotation ?? '—'}</td>
                <td class="px-3 py-1.5 text-text dark:text-text-dark">
                  <a href={getVenueHref(g.venue)} target="_blank" rel="noopener" class="hover:underline">{g.homeTeam}</a>
                  {homePitcher && <div class="text-[11px] font-normal text-text-muted dark:text-text-dark-muted">{homePitcher}</div>}
                </td>
                <td class="px-2 py-1.5 font-semibold text-text dark:text-text-dark">
                  {showScore ? g.homeScore ?? '' : ''}
                  {homeInning && <div class="text-[10px] font-normal uppercase text-field dark:text-field-light">{homeInning}</div>}
                </td>
                <td class="px-3 py-1.5 text-xs text-text dark:text-text-dark">{moneyline(dk, 'home')}</td>
                <td class="px-3 py-1.5 text-xs text-text dark:text-text-dark">{runLine(dk, 'home')}</td>
                <td class="px-3 py-1.5 text-xs text-text dark:text-text-dark">
                  {dk?.total ? `U ${dk.total.point} (${formatAmericanOdds(dk.total.underPrice)})` : '—'}
                </td>
                <td class="px-3 py-1.5 align-top text-xs leading-snug text-text-muted dark:text-text-dark-muted">
                  {homePointspreadEntries.length === 0
                    ? '—'
                    : homePointspreadEntries.map(e => (
                        <div class="mb-1 last:mb-0">
                          <a href={`/wagers/${e.wager.id}`} class="text-field hover:underline dark:text-field-light">{formatPointspreadEntry(e.wager, e.sides)}</a>
                        </div>
                      ))}
                </td>
                <td class="px-3 py-1.5 align-top text-xs leading-snug text-text-muted dark:text-text-dark-muted">
                  {homeOverUnders.length === 0
                    ? '—'
                    : homeOverUnders.map(w => (
                        <div class="mb-1 last:mb-0">
                          <a href={`/wagers/${w.id}`} class="text-field hover:underline dark:text-field-light">{formatOverUnderMarket(w)}</a>
                        </div>
                      ))}
                </td>
              </tr>
            </Fragment>
          );
        })}
      </tbody>
    </table>
  </div>
))}
