---
// Dense, table-based scoreboard (WagerTalk-style) — two rows per game (away
// on top, home on bottom), grouped under a date/league header bar.
import { formatAmericanOdds } from '../../lib/odds';
import { ordinal, windDirectionLabel, inningStateLabel } from '../../lib/weather-utils';
import { describeGameWeather, type EnrichedScheduleGame } from '../../lib/league-schedule';

interface Props {
  games: EnrichedScheduleGame[];
  leagueLabel: string; // e.g. "MLB", "NFL" — used in the group header bar
  emptyMessage: string;
}

const { games, leagueLabel, emptyMessage } = Astro.props;
const ET = 'America/New_York';

function groupDateLabel(iso: string): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return '';
  return d.toLocaleDateString('en-US', { timeZone: ET, weekday: 'long', month: 'long', day: 'numeric' });
}

function timeLabel(iso: string): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return '';
  return d.toLocaleTimeString('en-US', { timeZone: ET, hour: 'numeric', minute: '2-digit' }).replace(' ', '').toLowerCase();
}

/** "Delayed: Rain", "Suspended: Rain", "Postponed", etc. — MLB Stats API's detailedState. */
function isWeatherDelay(statusDetail: string): boolean {
  return /delay|suspend|postpone/i.test(statusDetail);
}

function moneyline(lines: EnrichedScheduleGame['lines'], side: 'home' | 'away'): string {
  if (!lines) return '—';
  return formatAmericanOdds(side === 'home' ? lines.moneylineHome : lines.moneylineAway);
}

function runLine(lines: EnrichedScheduleGame['lines'], side: 'home' | 'away'): string {
  const sp = lines ? (side === 'home' ? lines.spreadHome : lines.spreadAway) : null;
  return sp ? `${sp.point > 0 ? '+' : ''}${sp.point} (${formatAmericanOdds(sp.price)})` : '—';
}

function pitcherLabel(p: EnrichedScheduleGame['homePitcher']): string | null {
  if (!p) return null;
  return p.hand ? `${p.name} (${p.hand})` : p.name;
}

/** "Top"/"Middle" belong with the away half-inning, "Bottom"/"End" with home. */
function inningBadge(g: EnrichedScheduleGame, side: 'home' | 'away'): string | null {
  if (g.state !== 'in' || !g.inningState || !g.inning) return null;
  const isAwayHalf = g.inningState === 'Top' || g.inningState === 'Middle';
  if ((side === 'away') !== isAwayHalf) return null;
  return `${inningStateLabel(g.inningState)} ${ordinal(g.inning)}`;
}

// Group games into date sections, in the order they already arrive (soonest first).
const groups: { label: string; games: EnrichedScheduleGame[] }[] = [];
for (const g of games) {
  const label = groupDateLabel(g.kickoffUTC);
  const last = groups[groups.length - 1];
  if (last && last.label === label) last.games.push(g);
  else groups.push({ label, games: [g] });
}
---

{games.length === 0 && (
  <p class="rounded-xl border border-border bg-surface p-6 text-sm text-text-muted dark:border-border-dark dark:bg-surface-dark-alt dark:text-text-dark-muted">{emptyMessage}</p>
)}

{groups.map(group => (
  <div class="mb-6 overflow-x-auto rounded-lg border border-border dark:border-border-dark">
    <table class="w-full min-w-[900px] border-collapse text-sm">
      <thead>
        <tr class="bg-slate-700 text-left text-xs font-semibold uppercase tracking-wide text-white">
          <th class="px-3 py-2" colspan="8">{leagueLabel} — {group.label}</th>
        </tr>
        <tr class="border-b border-border bg-surface-alt text-left text-xs font-semibold text-text-muted dark:border-border-dark dark:bg-surface-dark-alt dark:text-text-dark-muted">
          <th class="px-3 py-1.5">Time</th>
          <th class="px-2 py-1.5">#</th>
          <th class="px-3 py-1.5">Team</th>
          <th class="px-2 py-1.5">Score</th>
          <th class="px-3 py-1.5">ML</th>
          <th class="px-3 py-1.5">RL</th>
          <th class="px-3 py-1.5">O/U</th>
          <th class="min-w-[260px] px-3 py-1.5">Weather</th>
        </tr>
      </thead>
      <tbody>
        {group.games.map(g => {
          const dk = g.lines;
          const showScore = g.state !== 'pre';
          const awayInning = inningBadge(g, 'away');
          const homeInning = inningBadge(g, 'home');
          const awayPitcher = pitcherLabel(g.awayPitcher);
          const homePitcher = pitcherLabel(g.homePitcher);
          return (
            <Fragment>
              <tr class="border-b border-border/60 bg-surface dark:border-border-dark/60 dark:bg-surface-dark-alt">
                <td class="px-3 py-1.5 align-top font-medium text-text dark:text-text-dark" rowspan="2">
                  {timeLabel(g.kickoffUTC)}
                  <div class="text-[10px] font-normal text-text-muted dark:text-text-dark-muted">ET</div>
                  {g.state !== 'pre' && <div class="text-[10px] font-normal uppercase text-field dark:text-field-light">{g.statusDetail || g.state}</div>}
                  {g.firstPitchWeather && (
                    <div class="mt-1 flex items-start gap-1">
                      <div class="relative h-5 w-5 shrink-0" aria-hidden="true">
                        <span class="absolute inset-0 flex items-center justify-center text-[13px] leading-none">⚾</span>
                        <svg viewBox="0 0 20 20" class="absolute inset-0 h-full w-full" style={`transform: rotate(${(g.firstPitchWeather.windDirectionDeg + 180) % 360}deg)`}>
                          <line x1="10" y1="10" x2="10" y2="3" stroke="#16a34a" stroke-width="2" stroke-linecap="round" />
                          <path d="M10 0.5 L7 5 L13 5 Z" fill="#16a34a" />
                        </svg>
                      </div>
                      <div class="text-[10px] font-normal leading-tight text-text-muted dark:text-text-dark-muted">
                        <div>{g.firstPitchWeather.tempF}°F · {g.firstPitchWeather.precipProbability}%</div>
                        <div>{g.firstPitchWeather.windSpeedMph} mph {windDirectionLabel(g.firstPitchWeather.windDirectionDeg)}, gust {g.firstPitchWeather.windGustMph}</div>
                      </div>
                    </div>
                  )}
                  {isWeatherDelay(g.statusDetail) && (
                    <div class="mt-0.5 max-w-[110px] whitespace-normal text-[10px] font-semibold text-amber-600 dark:text-amber-400">⚠ {g.statusDetail}</div>
                  )}
                </td>
                <td class="px-2 py-1.5 text-text-muted dark:text-text-dark-muted">{dk?.awayRotation ?? '—'}</td>
                <td class="px-3 py-1.5 text-text dark:text-text-dark">
                  {g.awayVenue ? (
                    <a href={`/venues/${g.awayVenue.id}`} target="_blank" rel="noopener" class="hover:underline">{g.awayTeam}</a>
                  ) : g.awayTeam}
                  {awayPitcher && <div class="text-[11px] font-normal text-text-muted dark:text-text-dark-muted">{awayPitcher}</div>}
                </td>
                <td class="px-2 py-1.5 font-semibold text-text dark:text-text-dark">
                  {showScore ? g.awayScore ?? '' : ''}
                  {awayInning && <div class="text-[10px] font-normal uppercase text-field dark:text-field-light">{awayInning}</div>}
                </td>
                <td class="px-3 py-1.5 text-xs text-text dark:text-text-dark">{moneyline(dk, 'away')}</td>
                <td class="px-3 py-1.5 text-xs text-text dark:text-text-dark">{runLine(dk, 'away')}</td>
                <td class="px-3 py-1.5 text-xs text-text dark:text-text-dark">
                  {dk?.total ? `O ${dk.total.point} (${formatAmericanOdds(dk.total.overPrice)})` : '—'}
                </td>
                <td class="px-3 py-1.5 align-top text-xs leading-snug text-text-muted dark:text-text-dark-muted" rowspan="2">{describeGameWeather(g)}</td>
              </tr>
              <tr class="border-b border-border bg-surface dark:border-border-dark dark:bg-surface-dark-alt">
                <td class="px-2 py-1.5 text-text-muted dark:text-text-dark-muted">{dk?.homeRotation ?? '—'}</td>
                <td class="px-3 py-1.5 text-text dark:text-text-dark">
                  <a href={`/venues/${g.venue.id}`} target="_blank" rel="noopener" class="hover:underline">{g.homeTeam}</a>
                  {homePitcher && <div class="text-[11px] font-normal text-text-muted dark:text-text-dark-muted">{homePitcher}</div>}
                </td>
                <td class="px-2 py-1.5 font-semibold text-text dark:text-text-dark">
                  {showScore ? g.homeScore ?? '' : ''}
                  {homeInning && <div class="text-[10px] font-normal uppercase text-field dark:text-field-light">{homeInning}</div>}
                </td>
                <td class="px-3 py-1.5 text-xs text-text dark:text-text-dark">{moneyline(dk, 'home')}</td>
                <td class="px-3 py-1.5 text-xs text-text dark:text-text-dark">{runLine(dk, 'home')}</td>
                <td class="px-3 py-1.5 text-xs text-text dark:text-text-dark">
                  {dk?.total ? `U ${dk.total.point} (${formatAmericanOdds(dk.total.underPrice)})` : '—'}
                </td>
              </tr>
            </Fragment>
          );
        })}
      </tbody>
    </table>
  </div>
))}
