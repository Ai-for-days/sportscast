---
// Weatherboard Extended (added 2026-08-23, per Derek): the detailed sibling
// of the plain Weatherboard — no DraftKings odds at all, just every one of
// this site's own published native weather markets for the game, broken out
// by exact type: Degrees HvH (both sides' daily highs), Degrees LvL (both
// sides' daily lows), Degrees HvL (cross-metric — including same-venue
// High-vs-Low), and Venue Degrees O/U (over/under at each side's own venue).
// Every entry links to a listing of ALL wagers for that specific game, not
// straight to one wager — the plain board sends people here first ("let them
// see all of their options"), and from here they pick one to actually bet.
import { ordinal, inningStateLabel } from '../../lib/weather-utils';
import { describeGameWeather, type EnrichedScheduleGame } from '../../lib/league-schedule';
import { getVenueZipUrl } from '../../lib/venue-zip';
import { getWesBand } from '../../lib/wes-scale';
import { getVenueHref } from '../../lib/venue-slug';
import {
  getPublishedWagersForGames, pointspreadsForGame, pointspreadsByCategory, overUndersForVenue,
  pointspreadEntriesForVenue, formatPointspreadEntry, formatOverUnderMarket, targetDateOf,
} from '../../lib/weatherboard-markets';

interface Props {
  games: EnrichedScheduleGame[];
  leagueLabel: string;
  emptyMessage: string;
}

const { games, leagueLabel, emptyMessage } = Astro.props;
const ET = 'America/New_York';

function groupDateLabel(iso: string): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return '';
  return d.toLocaleDateString('en-US', { timeZone: ET, weekday: 'long', month: 'long', day: 'numeric' });
}

function timeLabel(iso: string): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return '';
  return d.toLocaleTimeString('en-US', { timeZone: ET, hour: 'numeric', minute: '2-digit' }).replace(' ', '').toLowerCase();
}

function pitcherLabel(p: EnrichedScheduleGame['homePitcher']): string | null {
  if (!p) return null;
  return p.hand ? `${p.name} (${p.hand})` : p.name;
}

function inningBadge(g: EnrichedScheduleGame, side: 'home' | 'away'): string | null {
  if (g.state !== 'in') return null;
  if (g.inningState && g.inning) {
    const isAwayHalf = g.inningState === 'Top' || g.inningState === 'Middle';
    if ((side === 'away') !== isAwayHalf) return null;
    return `${inningStateLabel(g.inningState)} ${ordinal(g.inning)}`;
  }
  if (g.livePeriodClock) return side === 'home' ? g.livePeriodClock : null;
  return null;
}

function wesTitle(w: NonNullable<EnrichedScheduleGame['wes']>): string {
  const base = `WES ${Math.round(w.wesFinal)} — Environmental ${Math.round(w.environmental)}, Fan Feel ${Math.round(w.fanFeel)}, Player Feel ${Math.round(w.playerFeel)} (v${w.wesVersion})`;
  if (w.severeWeatherCap === null) return base;
  return `${base}\nSevere Weather Cap Applied: ${w.severeWeatherCap}\n${w.severeWeatherReason}`;
}

function venueZipUrl(g: EnrichedScheduleGame): string | null {
  return getVenueZipUrl(g.venue);
}

const allWagers = await getPublishedWagersForGames(games);

/** "All wagers for this game" — where every entry on this board links,
 * per Derek: pick a market here, then go bet it there. */
function gameWagersHref(g: EnrichedScheduleGame): string | null {
  if (!g.venue?.id || !g.awayVenue?.id) return null;
  const params = new URLSearchParams({
    home: g.venue.id,
    away: g.awayVenue.id,
    date: targetDateOf(g.kickoffUTC),
  });
  return `/wagers/game?${params.toString()}`;
}

const groups: { label: string; games: EnrichedScheduleGame[] }[] = [];
for (const g of games) {
  const label = groupDateLabel(g.kickoffUTC);
  const last = groups[groups.length - 1];
  if (last && last.label === label) last.games.push(g);
  else groups.push({ label, games: [g] });
}
---

{games.length === 0 && (
  <p class="rounded-xl border border-border bg-surface p-6 text-sm text-text-muted dark:border-border-dark dark:bg-surface-dark-alt dark:text-text-dark-muted">{emptyMessage}</p>
)}

{groups.map(group => (
  <div class="mb-6 overflow-x-auto rounded-lg border border-border dark:border-border-dark">
    <table class="w-full min-w-[900px] border-collapse text-sm">
      <thead>
        <tr class="bg-slate-700 text-left text-xs font-semibold uppercase tracking-wide text-white">
          <th class="px-3 py-2" colspan="9">{leagueLabel} — {group.label}</th>
        </tr>
        <tr class="border-b border-border bg-surface-alt text-left text-xs font-semibold text-text-muted dark:border-border-dark dark:bg-surface-dark-alt dark:text-text-dark-muted">
          <th class="px-3 py-1.5">Time</th>
          <th class="px-3 py-1.5">Team</th>
          <th class="px-2 py-1.5">Score</th>
          <th class="min-w-[130px] px-3 py-1.5">Degrees HvH</th>
          <th class="min-w-[130px] px-3 py-1.5">Degrees LvL</th>
          <th class="min-w-[130px] px-3 py-1.5">Degrees HvL</th>
          <th class="min-w-[160px] px-3 py-1.5">Venue Degrees O/U</th>
          <th class="min-w-[260px] px-3 py-1.5">Weather</th>
        </tr>
      </thead>
      <tbody>
        {group.games.map(g => {
          const showScore = g.state !== 'pre';
          const awayInning = inningBadge(g, 'away');
          const homeInning = inningBadge(g, 'home');
          const awayPitcher = pitcherLabel(g.awayPitcher);
          const homePitcher = pitcherLabel(g.homePitcher);
          const gamePointspreads = pointspreadsForGame(allWagers, g);
          const byCategory = pointspreadsByCategory(gamePointspreads);
          const awayHiHi = pointspreadEntriesForVenue(byCategory['hi-hi'], g.awayVenue);
          const awayLoLo = pointspreadEntriesForVenue(byCategory['lo-lo'], g.awayVenue);
          const awayHiLo = pointspreadEntriesForVenue(byCategory['hi-lo'], g.awayVenue);
          const homeHiHi = pointspreadEntriesForVenue(byCategory['hi-hi'], g.venue);
          const homeLoLo = pointspreadEntriesForVenue(byCategory['lo-lo'], g.venue);
          const homeHiLo = pointspreadEntriesForVenue(byCategory['hi-lo'], g.venue);
          const awayOverUnders = overUndersForVenue(allWagers, g.awayVenue);
          const homeOverUnders = overUndersForVenue(allWagers, g.venue);
          const href = gameWagersHref(g);
          return (
            <Fragment>
              <tr id={`game-${g.id}`} class="border-b border-black bg-surface dark:bg-surface-dark-alt">
                <td class="px-3 py-1.5 align-top font-medium text-text dark:text-text-dark" rowspan="2">
                  {timeLabel(g.kickoffUTC)}
                  <div class="text-[10px] font-normal text-text-muted dark:text-text-dark-muted">ET</div>
                  {g.state !== 'pre' && <div class="text-[10px] font-normal uppercase text-field dark:text-field-light">{g.statusDetail || g.state}</div>}
                </td>
                <td class="px-3 py-1.5 text-text dark:text-text-dark">
                  {g.awayVenue ? (
                    <a href={getVenueHref(g.awayVenue)} target="_blank" rel="noopener" class="hover:underline">{g.awayTeam}</a>
                  ) : g.awayTeam}
                  {awayPitcher && <div class="text-[11px] font-normal text-text-muted dark:text-text-dark-muted">{awayPitcher}</div>}
                </td>
                <td class="px-2 py-1.5 font-semibold text-text dark:text-text-dark">
                  {showScore ? g.awayScore ?? '' : ''}
                  {awayInning && <div class="text-[10px] font-normal uppercase text-field dark:text-field-light">{awayInning}</div>}
                </td>
                <td class="px-3 py-1.5 align-top text-xs leading-snug text-text-muted dark:text-text-dark-muted">
                  {awayHiHi.length === 0 || !href
                    ? (awayHiHi.length === 0 ? '—' : awayHiHi.map(e => <div class="mb-1 last:mb-0">{formatPointspreadEntry(e.wager, e.sides)}</div>))
                    : awayHiHi.map(e => (
                        <div class="mb-1 last:mb-0">
                          <a href={href} class="text-field hover:underline dark:text-field-light">{formatPointspreadEntry(e.wager, e.sides)}</a>
                        </div>
                      ))}
                </td>
                <td class="px-3 py-1.5 align-top text-xs leading-snug text-text-muted dark:text-text-dark-muted">
                  {awayLoLo.length === 0 || !href
                    ? (awayLoLo.length === 0 ? '—' : awayLoLo.map(e => <div class="mb-1 last:mb-0">{formatPointspreadEntry(e.wager, e.sides)}</div>))
                    : awayLoLo.map(e => (
                        <div class="mb-1 last:mb-0">
                          <a href={href} class="text-field hover:underline dark:text-field-light">{formatPointspreadEntry(e.wager, e.sides)}</a>
                        </div>
                      ))}
                </td>
                <td class="px-3 py-1.5 align-top text-xs leading-snug text-text-muted dark:text-text-dark-muted">
                  {awayHiLo.length === 0 || !href
                    ? (awayHiLo.length === 0 ? '—' : awayHiLo.map(e => <div class="mb-1 last:mb-0">{formatPointspreadEntry(e.wager, e.sides)}</div>))
                    : awayHiLo.map(e => (
                        <div class="mb-1 last:mb-0">
                          <a href={href} class="text-field hover:underline dark:text-field-light">{formatPointspreadEntry(e.wager, e.sides)}</a>
                        </div>
                      ))}
                </td>
                <td class="px-3 py-1.5 align-top text-xs leading-snug text-text-muted dark:text-text-dark-muted">
                  {awayOverUnders.length === 0 || !href
                    ? (awayOverUnders.length === 0 ? '—' : awayOverUnders.map(w => <div class="mb-1 last:mb-0">{formatOverUnderMarket(w)}</div>))
                    : awayOverUnders.map(w => (
                        <div class="mb-1 last:mb-0">
                          <a href={href} class="text-field hover:underline dark:text-field-light">{formatOverUnderMarket(w)}</a>
                        </div>
                      ))}
                </td>
                <td class="px-3 py-1.5 align-top text-xs leading-snug text-text-muted dark:text-text-dark-muted" rowspan="2">
                  {describeGameWeather(g)}
                  {g.wes && (() => {
                    const band = getWesBand(g.wes.wesFinal);
                    const bandVars = `--wes-light:${band.light};--wes-dark:${band.dark};`;
                    return (
                      <div class="mt-1.5" style={bandVars}>
                        <div class="flex items-center gap-1">
                          <div
                            class="wes-band-color inline-flex items-baseline gap-1 rounded-full border-2 px-2 py-0.5"
                            title={wesTitle(g.wes)}
                          >
                            <span class="wes-band-color text-[9px] font-semibold uppercase tracking-wide">WES</span>
                            <span class="wes-band-color text-xs font-bold">{Math.round(g.wes.wesFinal)}</span>
                          </div>
                          {g.state === 'in' && (
                            <span class="rounded bg-red-600 px-1 py-0.5 text-[8px] font-bold uppercase tracking-wide text-white">Live</span>
                          )}
                        </div>
                        <div class="wes-band-color mt-0.5 text-[9px] font-semibold">{band.label}</div>
                        <a href="/what-is-wes" class="mt-0.5 block text-[9px] font-semibold text-field hover:underline dark:text-field-light">What's WES?</a>
                      </div>
                    );
                  })()}
                  {venueZipUrl(g) && (
                    <a
                      href={venueZipUrl(g)!}
                      target="_blank"
                      rel="noopener"
                      class="mt-1.5 block text-[9px] font-semibold uppercase leading-tight text-field hover:underline dark:text-field-light"
                    >
                      Current Weather
                    </a>
                  )}
                </td>
              </tr>
              <tr class="border-b-2 border-black bg-surface dark:bg-surface-dark-alt">
                <td class="px-3 py-1.5 text-text dark:text-text-dark">
                  <a href={getVenueHref(g.venue)} target="_blank" rel="noopener" class="hover:underline">{g.homeTeam}</a>
                  {homePitcher && <div class="text-[11px] font-normal text-text-muted dark:text-text-dark-muted">{homePitcher}</div>}
                </td>
                <td class="px-2 py-1.5 font-semibold text-text dark:text-text-dark">
                  {showScore ? g.homeScore ?? '' : ''}
                  {homeInning && <div class="text-[10px] font-normal uppercase text-field dark:text-field-light">{homeInning}</div>}
                </td>
                <td class="px-3 py-1.5 align-top text-xs leading-snug text-text-muted dark:text-text-dark-muted">
                  {homeHiHi.length === 0 || !href
                    ? (homeHiHi.length === 0 ? '—' : homeHiHi.map(e => <div class="mb-1 last:mb-0">{formatPointspreadEntry(e.wager, e.sides)}</div>))
                    : homeHiHi.map(e => (
                        <div class="mb-1 last:mb-0">
                          <a href={href} class="text-field hover:underline dark:text-field-light">{formatPointspreadEntry(e.wager, e.sides)}</a>
                        </div>
                      ))}
                </td>
                <td class="px-3 py-1.5 align-top text-xs leading-snug text-text-muted dark:text-text-dark-muted">
                  {homeLoLo.length === 0 || !href
                    ? (homeLoLo.length === 0 ? '—' : homeLoLo.map(e => <div class="mb-1 last:mb-0">{formatPointspreadEntry(e.wager, e.sides)}</div>))
                    : homeLoLo.map(e => (
                        <div class="mb-1 last:mb-0">
                          <a href={href} class="text-field hover:underline dark:text-field-light">{formatPointspreadEntry(e.wager, e.sides)}</a>
                        </div>
                      ))}
                </td>
                <td class="px-3 py-1.5 align-top text-xs leading-snug text-text-muted dark:text-text-dark-muted">
                  {homeHiLo.length === 0 || !href
                    ? (homeHiLo.length === 0 ? '—' : homeHiLo.map(e => <div class="mb-1 last:mb-0">{formatPointspreadEntry(e.wager, e.sides)}</div>))
                    : homeHiLo.map(e => (
                        <div class="mb-1 last:mb-0">
                          <a href={href} class="text-field hover:underline dark:text-field-light">{formatPointspreadEntry(e.wager, e.sides)}</a>
                        </div>
                      ))}
                </td>
                <td class="px-3 py-1.5 align-top text-xs leading-snug text-text-muted dark:text-text-dark-muted">
                  {homeOverUnders.length === 0 || !href
                    ? (homeOverUnders.length === 0 ? '—' : homeOverUnders.map(w => <div class="mb-1 last:mb-0">{formatOverUnderMarket(w)}</div>))
                    : homeOverUnders.map(w => (
                        <div class="mb-1 last:mb-0">
                          <a href={href} class="text-field hover:underline dark:text-field-light">{formatOverUnderMarket(w)}</a>
                        </div>
                      ))}
                </td>
              </tr>
            </Fragment>
          );
        })}
      </tbody>
    </table>
  </div>
))}
