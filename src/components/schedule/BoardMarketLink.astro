---
// One market entry inside a Weatherboard cell.
//
// Per Derek (2026-08-27): a market that has locked stays VISIBLE on the board
// and is labeled closed. The three hours before kickoff plus game time are
// peak interest, and an empty cell there reads as "there is no market for this
// game" rather than "this one has closed."
//
// Per Derek (2026-08-31): "even if a wager is closed on /weatherboard or
// /weatherboard/extended, it should still be hyperlinked." It now is. The link
// was originally dropped because the market pages 404'd on anything closed;
// they open read-only now (see isPubliclyViewable in public-wager-view.ts), so
// there is nothing left to protect the customer from. A closed entry keeps its
// muted styling and its `closed` chip, so the link reads as "see this market"
// and never as "bet on this market".
interface Props {
  label: string;
  href: string;
  closed: boolean;
}
const { label, href, closed } = Astro.props;
---
{closed ? (
  <a
    href={href}
    class="text-text-muted hover:underline dark:text-text-dark-muted"
    title="Closed. This market locked before the game and is awaiting its result."
  >
    {label}
    <span class="ml-1 rounded bg-gray-200 px-1 py-0.5 text-[8px] font-bold uppercase tracking-wide text-gray-600 dark:bg-white/15 dark:text-white/70">
      closed
    </span>
  </a>
) : (
  <a href={href} class="text-field hover:underline dark:text-field-light">{label}</a>
)}
