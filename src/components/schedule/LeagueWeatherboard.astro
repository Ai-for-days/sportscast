---
// Shared body for each dedicated per-league Weatherboard page
// (/weatherboard/nfl, /weatherboard/college-football, /weatherboard/mlb,
// /weatherboard/mls) — Today/Tomorrow tabs, plus a calendar for anything
// further out, via ?date=YYYY-MM-DD on the SAME league page (not the
// all-sports /weatherboard/[date] page — reported live 2026-08-22: picking
// a date from the college-football calendar was dropping the league scope
// and landing on the mixed-sport date page instead). One component instead
// of 4 near-duplicate pages.
import Breadcrumbs from '../layout/Breadcrumbs.astro';
import WeatherboardTable from './WeatherboardTable.astro';
import { getScheduleGames, type SiteLeague } from '../../lib/league-schedule';
import { gameDayDateStr } from '../../lib/mlb-schedule';

interface Props {
  league: SiteLeague;
  label: string;
  venuesHref: string;
  /** The public URL segment under /weatherboard/ — differs from `league` only for NCAA football ('college-football' vs. 'ncaa-football'). */
  urlSegment: string;
  day: 'today' | 'tomorrow';
  /** Explicit YYYY-MM-DD from ?date=... on the page — overrides `day` when present. */
  date?: string | null;
}
const { league, label, venuesHref, urlSegment, day, date } = Astro.props;
const ET = 'America/New_York';
const basePath = `/weatherboard/${urlSegment}`;

function localDateStr(iso: string): string {
  const d = new Date(iso);
  return Number.isNaN(d.getTime()) ? '' : d.toLocaleDateString('en-CA', { timeZone: ET });
}
// "Today" runs 6am ET to 6am ET the next morning, not midnight to midnight
// — so last night's finals stay on the Today view until 6am, per Derek.
const todayStr = gameDayDateStr(new Date());
const tomorrowStr = gameDayDateStr(new Date(Date.now() + 86400000));

const isValidExplicitDate = !!date && /^\d{4}-\d{2}-\d{2}$/.test(date) && !Number.isNaN(Date.parse(`${date}T00:00:00Z`));
const targetDateStr = isValidExplicitDate ? date! : (day === 'tomorrow' ? tomorrowStr : todayStr);

// Bound the fetch window the same way /weatherboard/[date].astro does — a
// date more than 60 days out just shows "too far out" rather than paying
// for a huge schedule fetch.
const todayMs = Date.parse(`${todayStr}T00:00:00Z`);
const targetMs = Date.parse(`${targetDateStr}T00:00:00Z`);
const daysOut = Math.round((targetMs - todayMs) / 86400000);
const windowDays = isValidExplicitDate ? Math.max(1, Math.min(60, daysOut + 1)) : 2;
const tooFarOutOrPast = isValidExplicitDate && (daysOut < 0 || daysOut > 60);

const games = tooFarOutOrPast
  ? []
  : (await getScheduleGames(league, windowDays)).games.filter((g) => localDateStr(g.kickoffUTC) === targetDateStr);

const displayDate = isValidExplicitDate
  ? new Date(`${targetDateStr}T12:00:00`).toLocaleDateString('en-US', { timeZone: ET, weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' })
  : null;

const DAY_TABS = [
  { key: 'today', label: 'Today' },
  { key: 'tomorrow', label: 'Tomorrow' },
] as const;
---

<Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'The Weatherboard', href: '/weatherboard' }, { label }]} />
<header class="mt-3">
  <h1 class="text-3xl font-bold text-text dark:text-text-dark">{label} — The Weatherboard</h1>
  <p class="mt-2 max-w-3xl text-text dark:text-text-dark">
    {isValidExplicitDate
      ? <Fragment>Tracked {label} games on <strong>{displayDate}</strong> — venue, a game-day weather write-up, Weather Experience Score, and DraftKings moneyline / run line / total with official rotation numbers.</Fragment>
      : <Fragment>Today and tomorrow's tracked {label} games — venue, a game-day weather write-up, Weather Experience Score, and DraftKings moneyline / run line / total with official rotation numbers. Looking further out? Use the calendar below.</Fragment>}
  </p>
</header>

<div class="mt-5 flex flex-wrap items-end justify-between gap-3 border-b border-border dark:border-border-dark">
  <nav class="flex flex-wrap gap-1" aria-label="Day">
    {DAY_TABS.map(t => (
      <a
        href={t.key === 'today' ? basePath : `${basePath}?day=${t.key}`}
        aria-current={(!isValidExplicitDate && t.key === day) ? 'page' : undefined}
        class:list={[
          'rounded-t-lg border-b-2 px-4 py-2 text-sm font-semibold transition-colors',
          (!isValidExplicitDate && t.key === day)
            ? 'border-field text-field-dark dark:text-field-light'
            : 'border-transparent text-text-muted hover:text-text dark:text-text-dark-muted dark:hover:text-text-dark',
        ]}
      >
        {t.label}
      </a>
    ))}
  </nav>
  <div class="mb-2 flex items-center gap-2">
    <label class="text-sm text-text-muted dark:text-text-dark-muted" for="wb-date-jump">Any other date</label>
    <input type="date" id="wb-date-jump" value={isValidExplicitDate ? targetDateStr : undefined} class="rounded-lg border border-border bg-surface px-3 py-1.5 text-sm dark:border-border-dark dark:bg-surface-dark-alt dark:text-text-dark" />
  </div>
</div>

<div class="mt-5">
  {tooFarOutOrPast && (
    <p class="rounded-xl border border-border bg-surface p-6 text-sm text-text-muted dark:border-border-dark dark:bg-surface-dark-alt dark:text-text-dark-muted">
      {daysOut < 0 ? 'That date has already passed.' : 'That date is too far out to have a tracked schedule yet.'}
    </p>
  )}
  {!tooFarOutOrPast && games.length === 0 && (
    <p class="rounded-xl border border-border bg-surface p-6 text-sm text-text-muted dark:border-border-dark dark:bg-surface-dark-alt dark:text-text-dark-muted">
      No tracked {label} games {isValidExplicitDate ? `on ${displayDate}` : (day === 'today' ? 'today' : 'tomorrow')}.
    </p>
  )}
  {games.length > 0 && <WeatherboardTable games={games} leagueLabel={label} emptyMessage="" />}
  <a href={venuesHref} class="mt-2 inline-block text-sm font-semibold text-field hover:underline dark:text-field-light">Browse {label} venue forecasts →</a>
</div>

<a href="/weatherboard" class="mt-4 inline-block text-sm font-semibold text-field hover:underline dark:text-field-light">← Back to The Weatherboard (all sports, today)</a>

<script define:vars={{ basePath }}>
  document.getElementById('wb-date-jump')?.addEventListener('change', (e) => {
    const value = e.currentTarget.value;
    if (value) window.location.href = `${basePath}?date=${value}`;
  });
</script>
