---
import { getVenueLogoUrl } from '../../lib/venue-data';
import { formatDMYTime } from '../../lib/date-format';
import { formatAmericanOdds } from '../../lib/odds';
import type { EnrichedScheduleGame } from '../../lib/league-schedule';

interface Props {
  game: EnrichedScheduleGame;
}

const { game } = Astro.props;
const ET = 'America/New_York';
const homeLogo = getVenueLogoUrl(game.venue.id);
const zipHref = `/venues/${game.venue.id}`;

const roofLabel = { outdoor: 'Open air', indoor: 'Indoor', retractable: 'Retractable roof' }[game.venue.type];
---

<article class="rounded-xl border border-border bg-surface p-4 dark:border-border-dark dark:bg-surface-dark-alt">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 class="flex items-center gap-2 text-lg font-bold text-text dark:text-text-dark">
      {homeLogo && <img src={homeLogo} alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 w-6 shrink-0 object-contain" />}
      {game.awayTeam} <span class="text-text-muted dark:text-text-dark-muted">@</span> {game.homeTeam}
    </h2>
    <span class="text-sm text-text-muted dark:text-text-dark-muted">
      {formatDMYTime(game.kickoffUTC, { timeZone: ET, zoneLabel: 'ET' })}
      {game.state !== 'pre' && game.statusDetail ? ` · ${game.statusDetail}` : ''}
    </span>
  </div>

  <p class="mt-0.5 text-sm text-text-muted dark:text-text-dark-muted">
    <a href={zipHref} class="font-medium text-field hover:underline dark:text-field-light">{game.venue.name}</a> · {game.venue.city}, {game.venue.state} · {roofLabel}
  </p>

  <!-- Weather -->
  <div class="mt-3 border-t border-border pt-3 dark:border-border-dark">
    {!game.weatherMatters && (
      <p class="text-sm text-text-muted dark:text-text-dark-muted">Indoor venue — climate-controlled, weather is not a factor.</p>
    )}
    {game.weatherMatters && !game.day && (
      <p class="text-sm text-text-muted dark:text-text-dark-muted">Forecast available closer to game day.</p>
    )}
    {game.weatherMatters && game.day && (
      <div class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm">
        <span class="text-xl font-bold text-text dark:text-text-dark">{Math.round(game.day.highF)}°<span class="text-sm font-normal text-text-muted dark:text-text-dark-muted"> / {Math.round(game.day.lowF)}°</span></span>
        <span class="text-text dark:text-text-dark">{game.day.description}</span>
        <span class="text-text-muted dark:text-text-dark-muted">Wind {Math.round(game.day.windSpeedMph)} mph</span>
        <span class="text-text-muted dark:text-text-dark-muted">{game.day.precipProbability}% rain</span>
      </div>
    )}
  </div>

  <!-- Odds -->
  {game.lines && (
    <div class="mt-3 border-t border-border pt-3 dark:border-border-dark">
      <h3 class="text-xs font-semibold uppercase tracking-wide text-text-muted dark:text-text-dark-muted">
        Betting Lines <span class="font-normal normal-case">· {game.lines.bookmaker}</span>
      </h3>
      <div class="mt-1.5 grid gap-2 sm:grid-cols-3">
        <div>
          <div class="text-xs text-text-muted dark:text-text-dark-muted">Moneyline</div>
          <div class="text-sm text-text dark:text-text-dark">{game.homeTeam} {formatAmericanOdds(game.lines.moneylineHome)} · {game.awayTeam} {formatAmericanOdds(game.lines.moneylineAway)}</div>
        </div>
        {game.lines.spreadHome && (
          <div>
            <div class="text-xs text-text-muted dark:text-text-dark-muted">Spread</div>
            <div class="text-sm text-text dark:text-text-dark">{game.homeTeam} {game.lines.spreadHome.point > 0 ? '+' : ''}{game.lines.spreadHome.point} ({formatAmericanOdds(game.lines.spreadHome.price)})</div>
          </div>
        )}
        {game.lines.total && (
          <div>
            <div class="text-xs text-text-muted dark:text-text-dark-muted">Total</div>
            <div class="text-sm text-text dark:text-text-dark">O/U {game.lines.total.point} ({formatAmericanOdds(game.lines.total.overPrice)} / {formatAmericanOdds(game.lines.total.underPrice)})</div>
          </div>
        )}
      </div>
      <p class="mt-1.5 text-[11px] text-text-muted dark:text-text-dark-muted">Informational only, not betting advice. Odds move; confirm at your sportsbook. 21+ and physically present in an eligible state. Gambling problem? Call 1-800-GAMBLER.</p>
    </div>
  )}

  <!-- Injuries -->
  {(game.homeInjuries.length > 0 || game.awayInjuries.length > 0) && (
    <div class="mt-3 border-t border-border pt-3 dark:border-border-dark">
      <h3 class="text-xs font-semibold uppercase tracking-wide text-text-muted dark:text-text-dark-muted">Injury Report</h3>
      <div class="mt-1.5 grid gap-3 sm:grid-cols-2">
        <div>
          <div class="text-xs font-semibold text-text dark:text-text-dark">{game.awayTeam}</div>
          {game.awayInjuries.length > 0 ? (
            <ul class="mt-0.5 space-y-0.5 text-xs text-text-muted dark:text-text-dark-muted">
              {game.awayInjuries.map(inj => <li>{inj.playerName} — {inj.status}</li>)}
            </ul>
          ) : (
            <p class="mt-0.5 text-xs text-text-muted dark:text-text-dark-muted">No injuries reported</p>
          )}
        </div>
        <div>
          <div class="text-xs font-semibold text-text dark:text-text-dark">{game.homeTeam}</div>
          {game.homeInjuries.length > 0 ? (
            <ul class="mt-0.5 space-y-0.5 text-xs text-text-muted dark:text-text-dark-muted">
              {game.homeInjuries.map(inj => <li>{inj.playerName} — {inj.status}</li>)}
            </ul>
          ) : (
            <p class="mt-0.5 text-xs text-text-muted dark:text-text-dark-muted">No injuries reported</p>
          )}
        </div>
      </div>
    </div>
  )}
</article>
