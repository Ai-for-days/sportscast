---
// Per-inning field card — one of four (Wind, Gusts, Temperature,
// Precipitation) rendered side by side on MLB venue pages. Wind/gust share
// the true-compass field-diagram + arrow (see the orientation note below);
// temperature/precipitation reuse the same shell (rotated field image,
// big readout, inning picker) without an arrow, since they have no
// direction to show.
//
// The field artwork and the wind arrow are both drawn in a single fixed,
// north-up frame (compass "N" pinned at the top of the circle, never
// rotates). The field image itself is what rotates: by the stadium's real
// compass orientation (centerFieldBearingDeg — home plate through the mound
// to straightaway center field, see stadium-orientations.json), so the
// artwork always shows which way the park actually faces. The wind arrow
// rotates by the true compass bearing the wind blows TOWARD, in that same
// frame — no relative-angle math needed for the arrow, since field and
// arrow already share one coordinate system. The arrow is drawn as one
// continuous shaft through the hub (a tail extending the same distance
// behind the hub as the arrowhead extends in front), not a one-sided ray,
// so it reads as a single wind vector crossing the field rather than a
// pointer stuck to the middle.
//
// Gusts get their OWN card now (previously a toggle on the wind card) —
// same field-relative direction (Open-Meteo doesn't give gusts a separate
// bearing), different color/speed.
import { fieldWindLabel } from '../../lib/stadium-wind';
import { inningAtMinutes, type GameForecastSlot } from '../../lib/mlb-game-forecast';
import { ordinal } from '../../lib/weather-utils';

type Metric = 'wind' | 'gust' | 'temp' | 'precip';

interface Props {
  metric: Metric;
  centerFieldBearingDeg: number;
  slots: GameForecastSlot[];
}

const { metric, centerFieldBearingDeg, slots } = Astro.props;

const META: Record<Metric, { title: string; unit: string; color: string; hasArrow: boolean }> = {
  wind: { title: 'Wind on the Field', unit: 'mph', color: '#22c55e', hasArrow: true },
  gust: { title: 'Gusts on the Field', unit: 'mph', color: '#ef4444', hasArrow: true },
  temp: { title: 'Temperature on the Field', unit: '°F', color: '#f59e0b', hasArrow: false },
  precip: { title: 'Precipitation on the Field', unit: '%', color: '#3b82f6', hasArrow: false },
};
const meta = META[metric];

function valueFor(s: GameForecastSlot): number {
  if (metric === 'wind') return s.windSpeedMph;
  if (metric === 'gust') return s.windGustMph;
  if (metric === 'temp') return s.tempF;
  return s.precipProbability;
}

function secondaryFor(s: GameForecastSlot): string {
  if (metric === 'wind') return `${s.tempF}°F · ${s.precipProbability}% rain`;
  if (metric === 'gust') return `${s.windSpeedMph} mph sustained · ${s.tempF}°F`;
  if (metric === 'temp') return `${s.windSpeedMph} mph wind · ${s.precipProbability}% rain`;
  return `${s.tempF}°F · ${s.windSpeedMph} mph wind`;
}

const slotData = slots.map((s) => ({
  label: ordinal(inningAtMinutes(s.minutesFromFirstPitch)),
  value: valueFor(s),
  secondary: secondaryFor(s),
  blowingTowardDeg: (s.windDirectionDeg + 180) % 360,
  fieldLabel: meta.hasArrow ? fieldWindLabel(s.windDirectionDeg, centerFieldBearingDeg) : '',
}));
---

{slotData.length > 0 && (
  <div class="field-metric-card" data-slots={JSON.stringify(slotData)} data-has-arrow={String(meta.hasArrow)} data-color={meta.color}>
    <h3 class="text-sm font-semibold uppercase tracking-wide text-text-muted dark:text-text-dark-muted">{meta.title}</h3>

    <div class="mt-3 flex flex-col items-center gap-3 sm:flex-row sm:items-start">
      <div class="flex shrink-0 flex-col items-center">
        {meta.hasArrow ? (
          <span class="mb-1 text-[10px] font-bold tracking-wide text-text-muted dark:text-text-dark-muted">N ↑</span>
        ) : (
          <span class="mb-1 text-[10px] font-bold tracking-wide text-text-muted dark:text-text-dark-muted">&nbsp;</span>
        )}
        <div class="relative h-40 w-40 overflow-hidden rounded-full border border-border bg-white dark:border-border-dark">
          <img
            src="/images/venues/mlb-field-diagram.png"
            alt="Field diagram, oriented to the stadium's real compass direction"
            width="600"
            height="600"
            loading="lazy"
            decoding="async"
            style={`transform: rotate(${centerFieldBearingDeg}deg);`}
            class="h-full w-full object-cover"
          />
          {meta.hasArrow && (
            <svg viewBox="0 0 200 200" class="pointer-events-none absolute inset-0 h-full w-full" role="img" aria-label={`${meta.title} direction arrow`}>
              <g data-arrow-group transform="rotate(0 100 100)" style="transition: transform 0.2s ease;">
                <line x1="100" y1="182" x2="100" y2="100" stroke={meta.color} data-arrow-tail stroke-width="5" stroke-linecap="round" />
                <line x1="100" y1="100" x2="100" y2="28" stroke={meta.color} data-arrow-line stroke-width="5" stroke-linecap="round" />
                <path d="M 100 18 L 89 38 L 111 38 Z" fill={meta.color} data-arrow-head />
              </g>
              <circle cx="100" cy="100" r="4" fill="#111827" data-arrow-hub />
            </svg>
          )}
        </div>
      </div>

      <div class="min-w-0 flex-1">
        <div class="flex items-baseline gap-2">
          <span class="text-3xl font-bold text-text dark:text-text-dark" data-value>–</span>
          <span class="text-sm text-text-muted dark:text-text-dark-muted">{meta.unit}</span>
          {meta.hasArrow && <span class="text-sm font-semibold text-text dark:text-text-dark" data-field-label>–</span>}
        </div>
        <p class="mt-1 text-xs text-text-muted dark:text-text-dark-muted" data-secondary>–</p>

        <div class="mt-3 flex flex-wrap items-center gap-1" role="group" aria-label="Inning">
          <span class="mr-1 text-[10px] font-semibold uppercase tracking-wide text-text-muted dark:text-text-dark-muted">Inning</span>
          {slotData.map((s, i) => (
            <button
              type="button"
              data-slot-btn={i}
              class="wd-slot-btn rounded px-2 py-1 text-[11px] font-semibold"
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {s.label}
            </button>
          ))}
        </div>
      </div>
    </div>

    <p class="mt-3 text-[11px] text-text-muted dark:text-text-dark-muted">
      {meta.hasArrow ? 'Field-relative direction, ' : 'One reading '}per inning (1st through {slotData.length ? ordinal(slotData.length) : '9th'}, ~20 minutes apart). Not betting advice.
    </p>
  </div>
)}

<style>
  .wd-slot-btn { background: transparent; border: 1px solid var(--color-border, #e5e7eb); color: var(--color-text-muted, #6b7280); }
  .wd-slot-btn[aria-pressed="true"] { background: rgba(34,197,94,0.12); border-color: #22c55e; color: #16a34a; }
  :global(.dark) .wd-slot-btn[aria-pressed="true"] { color: #4ade80; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.field-metric-card').forEach((root) => {
    const slots = JSON.parse(root.dataset.slots || '[]') as Array<{
      value: number;
      secondary: string;
      blowingTowardDeg: number;
      fieldLabel: string;
    }>;
    if (!slots.length) return;

    const hasArrow = root.dataset.hasArrow === 'true';
    let slotIndex = 0;

    const arrowGroup = root.querySelector<SVGGElement>('[data-arrow-group]');
    const valueEl = root.querySelector<HTMLElement>('[data-value]');
    const fieldLabelEl = root.querySelector<HTMLElement>('[data-field-label]');
    const secondaryEl = root.querySelector<HTMLElement>('[data-secondary]');
    const slotBtns = root.querySelectorAll<HTMLButtonElement>('[data-slot-btn]');

    function render() {
      const s = slots[slotIndex];
      if (!s) return;
      if (valueEl) valueEl.textContent = String(s.value);
      if (fieldLabelEl) fieldLabelEl.textContent = s.fieldLabel;
      if (secondaryEl) secondaryEl.textContent = s.secondary;
      if (hasArrow && arrowGroup) arrowGroup.setAttribute('transform', `rotate(${s.blowingTowardDeg} 100 100)`);
    }

    slotBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        slotIndex = Number(btn.dataset.slotBtn ?? 0);
        slotBtns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        render();
      });
    });

    render();
  });
</script>
