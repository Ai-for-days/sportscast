---
// Field-relative wind diagram for a game window — true-compass model.
//
// The field artwork and the wind arrow are both drawn in a single fixed,
// north-up frame (compass "N" pinned at the top of the circle, never
// rotates). The field image itself is what rotates: by the stadium's real
// compass orientation (centerFieldBearingDeg — home plate through the mound
// to straightaway center field, see stadium-orientations.json), so the
// artwork always shows which way the park actually faces. The wind arrow
// rotates by the true compass bearing the wind blows TOWARD, in that same
// frame — no relative-angle math needed for the arrow, since field and
// arrow already share one coordinate system.
//
// Gusts share the sustained wind's direction in our data (Open-Meteo doesn't
// give gusts a separate bearing), so the Wind/Gust toggle only changes which
// speed drives the arrow length/color and the headline number — the arrow
// angle is the same either way.
import { fieldWindLabel } from '../../lib/stadium-wind';
import type { GameForecastSlot } from '../../lib/mlb-game-forecast';

interface Props {
  centerFieldBearingDeg: number;
  slots: GameForecastSlot[];
  timeZone: string;
}

const { centerFieldBearingDeg, slots, timeZone } = Astro.props;

const WIND_COLOR = '#22c55e';
const GUST_COLOR = '#ef4444';

function minutesLabel(minutes: number): string {
  if (minutes === 0) return 'First pitch';
  const h = Math.floor(minutes / 60);
  const m = minutes % 60;
  return `+${h ? `${h}h${m ? `${m}m` : ''}` : `${m}m`}`;
}

const slotData = slots.map((s) => ({
  minutesFromFirstPitch: s.minutesFromFirstPitch,
  label: minutesLabel(s.minutesFromFirstPitch),
  clock: new Date(s.timeUTC).toLocaleTimeString('en-US', { timeZone, hour: 'numeric', minute: '2-digit' }),
  windSpeedMph: s.windSpeedMph,
  windGustMph: s.windGustMph,
  // True compass bearing the wind blows TOWARD (0 = N, clockwise) — the arrow's
  // rotation in the fixed north-up frame.
  blowingTowardDeg: (s.windDirectionDeg + 180) % 360,
  fieldLabel: fieldWindLabel(s.windDirectionDeg, centerFieldBearingDeg),
  tempF: s.tempF,
  precipProbability: s.precipProbability,
}));
---

{slotData.length > 0 && (
  <div class="wind-diagram" data-slots={JSON.stringify(slotData)}>
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h3 class="text-sm font-semibold uppercase tracking-wide text-text-muted dark:text-text-dark-muted">Wind on the Field</h3>
      <div class="flex overflow-hidden rounded-lg border border-border dark:border-border-dark" role="group" aria-label="Wind or gusts">
        <button type="button" data-metric-btn="wind" class="wd-metric-btn px-3 py-1 text-xs font-semibold" aria-pressed="true">Wind</button>
        <button type="button" data-metric-btn="gust" class="wd-metric-btn px-3 py-1 text-xs font-semibold" aria-pressed="false">Gusts</button>
      </div>
    </div>

    <div class="mt-3 flex flex-col items-center gap-3 sm:flex-row sm:items-start">
      <div class="flex shrink-0 flex-col items-center">
        <span class="mb-1 text-[10px] font-bold tracking-wide text-text-muted dark:text-text-dark-muted">N ↑</span>
        <div class="relative h-40 w-40 overflow-hidden rounded-full border border-border bg-white dark:border-border-dark">
          <img
            src="/images/venues/mlb-field-diagram.png"
            alt="Field diagram, oriented to the stadium's real compass direction"
            width="600"
            height="600"
            loading="lazy"
            decoding="async"
            data-field-image
            style={`transform: rotate(${centerFieldBearingDeg}deg);`}
            class="h-full w-full object-cover"
          />
          <svg viewBox="0 0 200 200" class="pointer-events-none absolute inset-0 h-full w-full" role="img" aria-label="Wind direction arrow">
            <g data-wind-arrow transform="rotate(0 100 100)" style="transition: transform 0.2s ease;">
              <line x1="100" y1="100" x2="100" y2="28" stroke={WIND_COLOR} data-arrow-line stroke-width="5" stroke-linecap="round" />
              <path d="M 100 18 L 89 38 L 111 38 Z" fill={WIND_COLOR} data-arrow-head />
            </g>
            <circle cx="100" cy="100" r="4" fill="#111827" data-arrow-hub />
          </svg>
        </div>
      </div>

      <div class="min-w-0 flex-1">
        <div class="flex items-baseline gap-2">
          <span class="text-3xl font-bold text-text dark:text-text-dark" data-speed-value>–</span>
          <span class="text-sm text-text-muted dark:text-text-dark-muted">mph</span>
          <span class="text-sm font-semibold text-text dark:text-text-dark" data-field-label>–</span>
        </div>
        <p class="mt-1 text-xs text-text-muted dark:text-text-dark-muted">
          <span data-slot-temp>–</span>&deg;F &middot; <span data-slot-precip>–</span>% rain &middot; <span data-slot-clock>–</span>
        </p>

        <div class="mt-3 flex flex-wrap gap-1" role="group" aria-label="Time into the game">
          {slotData.map((s, i) => (
            <button
              type="button"
              data-slot-btn={i}
              class="wd-slot-btn rounded px-2 py-1 text-[11px] font-semibold"
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {s.label}
            </button>
          ))}
        </div>
      </div>
    </div>

    <p class="mt-3 text-[11px] text-text-muted dark:text-text-dark-muted">
      Field-relative wind direction from first pitch through {Math.round((slotData[slotData.length - 1]?.minutesFromFirstPitch ?? 0) / 60)} hours after, in 30-minute steps. Not betting advice.
    </p>
  </div>
)}

<style>
  .wd-metric-btn { background: transparent; color: var(--color-text-muted, #6b7280); }
  .wd-metric-btn[aria-pressed="true"] { background: rgba(34,197,94,0.12); color: #16a34a; }
  :global(.dark) .wd-metric-btn[aria-pressed="true"] { color: #4ade80; }
  .wd-slot-btn { background: transparent; border: 1px solid var(--color-border, #e5e7eb); color: var(--color-text-muted, #6b7280); }
  .wd-slot-btn[aria-pressed="true"] { background: rgba(34,197,94,0.12); border-color: #22c55e; color: #16a34a; }
  :global(.dark) .wd-slot-btn[aria-pressed="true"] { color: #4ade80; }
</style>

<script>
  const WIND_COLOR = '#22c55e';
  const GUST_COLOR = '#ef4444';

  document.querySelectorAll<HTMLElement>('.wind-diagram').forEach((root) => {
    const slots = JSON.parse(root.dataset.slots || '[]') as Array<{
      minutesFromFirstPitch: number;
      clock: string;
      windSpeedMph: number;
      windGustMph: number;
      blowingTowardDeg: number;
      fieldLabel: string;
      tempF: number;
      precipProbability: number;
    }>;
    if (!slots.length) return;

    let metric: 'wind' | 'gust' = 'wind';
    let slotIndex = 0;

    const arrowGroup = root.querySelector<SVGGElement>('[data-wind-arrow]');
    const arrowLine = root.querySelector<SVGLineElement>('[data-arrow-line]');
    const arrowHead = root.querySelector<SVGPathElement>('[data-arrow-head]');
    const speedEl = root.querySelector<HTMLElement>('[data-speed-value]');
    const fieldLabelEl = root.querySelector<HTMLElement>('[data-field-label]');
    const tempEl = root.querySelector<HTMLElement>('[data-slot-temp]');
    const precipEl = root.querySelector<HTMLElement>('[data-slot-precip]');
    const clockEl = root.querySelector<HTMLElement>('[data-slot-clock]');
    const metricBtns = root.querySelectorAll<HTMLButtonElement>('[data-metric-btn]');
    const slotBtns = root.querySelectorAll<HTMLButtonElement>('[data-slot-btn]');

    function render() {
      const s = slots[slotIndex];
      if (!s) return;
      const speed = metric === 'wind' ? s.windSpeedMph : s.windGustMph;
      const color = metric === 'wind' ? WIND_COLOR : GUST_COLOR;
      if (speedEl) speedEl.textContent = String(speed);
      if (fieldLabelEl) fieldLabelEl.textContent = s.fieldLabel;
      if (tempEl) tempEl.textContent = String(s.tempF);
      if (precipEl) precipEl.textContent = String(s.precipProbability);
      if (clockEl) clockEl.textContent = s.clock;
      if (arrowGroup) arrowGroup.setAttribute('transform', `rotate(${s.blowingTowardDeg} 100 100)`);
      if (arrowLine) arrowLine.setAttribute('stroke', color);
      if (arrowHead) arrowHead.setAttribute('fill', color);
    }

    metricBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        metric = (btn.dataset.metricBtn as 'wind' | 'gust') ?? 'wind';
        metricBtns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        render();
      });
    });
    slotBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        slotIndex = Number(btn.dataset.slotBtn ?? 0);
        slotBtns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        render();
      });
    });

    render();
  });
</script>
