---
// Admin Hub (WOW-024 slice B): the admin's front door at /admin for a signed-in
// admin. Pure server-rendered links from the nav registry: no fetch, no Redis,
// no polling, no hidden pages.
import { SECTION_ORDER, entriesFor } from '../../lib/admin-nav-registry';

const START_HERE = [
  { route: '/admin/system/weather-market-daily-brief', label: 'Daily Brief' },
  { route: '/admin/wagers', label: 'Wager Dashboard' },
  { route: '/admin/system/wager-resolution', label: 'Wager Resolution' },
  { route: '/admin/system/alert-log', label: 'Alert Log' },
];

const cards = SECTION_ORDER.map((s) => ({
  ...s,
  links: entriesFor(s.id).filter((x) => x.route !== '/admin'),
}));
---

<div class="mx-auto max-w-6xl px-4 py-6 text-slate-900" style="color-scheme: light;">
  <h1 class="text-2xl font-bold">Admin Home</h1>
  <p class="mt-1 text-sm text-slate-600">Every admin tool, by section. The same sections are in the menu at the top of every admin page.</p>

  <div class="mt-5 flex flex-wrap gap-2">
    <span class="self-center text-xs font-semibold uppercase tracking-wide text-slate-500">Start here</span>
    {START_HERE.map((x) => (
      <a href={x.route} class="rounded-lg bg-blue-700 px-4 py-2 text-sm font-bold text-white no-underline hover:bg-blue-800">{x.label}</a>
    ))}
  </div>

  <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
    {cards.filter((c) => !c.collapsed).map((c) => (
      <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <h2 class="text-base font-bold">{c.title}</h2>
        <p class="mt-1 text-xs text-slate-500">{c.blurb}</p>
        <ul class="mt-3 space-y-1">
          {c.links.map((x) => (
            <li><a href={x.route} class="text-sm font-semibold text-blue-700 hover:underline" title={x.description}>{x.title}</a></li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
    {cards.filter((c) => c.collapsed).map((c) => (
      <details class="rounded-xl border border-slate-200 bg-slate-50 p-4">
        <summary class="cursor-pointer text-base font-bold">{c.title} <span class="text-xs font-normal text-slate-500">({c.links.length})</span></summary>
        <p class="mt-1 text-xs text-slate-500">{c.blurb}</p>
        <ul class="mt-3 columns-1 gap-4 space-y-1 sm:columns-2">
          {c.links.map((x) => (
            <li><a href={x.route} class="text-sm text-blue-700 hover:underline" title={x.description}>{x.title}</a></li>
          ))}
        </ul>
      </details>
    ))}
  </div>
</div>
